<div class="spf-window-body simplysf2e-generator spf-hud">
  {{> simplysf2e-statusbar appId="itemforge" hideLastRunWithReport=true sourcesDetail=(localize "SIMPLYSF2E.ItemForge.SourcesDetail")}}

  <fieldset class="spf-inputs spf-card" {{#if busy}}disabled{{/if}}>
    <legend>{{localize "SIMPLYSF2E.ItemForge.ConceptLegend"}}</legend>
    {{! Compact kind switch: all five kinds equally visible as one segmented
        row; the selected kind's description shows once below. The selected
        button carries aria-pressed, a frame and a thick underline bar, not
        colour alone; each button's tooltip holds its own description. }}
    <div class="spf-kind-choices" role="group" aria-label="{{localize 'SIMPLYSF2E.ItemForge.Kind'}}">
      {{#each kinds}}
        <button type="button" class="spf-kind-choice {{#if this.selected}}spf-kind-selected{{/if}}" data-action="selectKind" data-kind="{{this.value}}" aria-pressed="{{this.selected}}" data-tooltip="{{localize this.hint}}" {{#if this.selected}}aria-describedby="spf-kind-hint"{{/if}} {{#if @root.busy}}disabled{{/if}}>
          <i class="fa-solid {{this.icon}}" aria-hidden="true"></i>
          <span class="spf-kind-label">{{localize this.short}}</span>
        </button>
      {{/each}}
    </div>
    <p id="spf-kind-hint" class="spf-kind-hint">{{#each kinds}}{{#if this.selected}}<strong>{{localize this.label}}:</strong> {{localize this.hint}}{{/if}}{{/each}}</p>
    <div class="form-group stacked">
      <label for="spf-itemforge-prompt">{{localize "SIMPLYSF2E.ItemForge.Prompt"}}</label>
      <textarea id="spf-itemforge-prompt" name="prompt" rows="3" placeholder="{{promptPlaceholder}}">{{input.prompt}}</textarea>
    </div>
    <div class="spf-row spf-itemforge-levelrow">
      <div class="form-group">
        <label for="spf-itemforge-level">{{localize "SIMPLYSF2E.ItemForge.Level"}}</label>
        <div class="spf-level-controls">
          <button type="button" class="spf-icon-btn" data-action="levelDown" data-tooltip="{{localize 'SIMPLYSF2E.Generator.LevelDown'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.LevelDown'}}">
            <i aria-hidden="true" class="fa-solid fa-minus"></i>
          </button>
          <input id="spf-itemforge-level" type="number" name="level" min="{{minLevel}}" max="{{maxLevel}}" step="1" value="{{input.level}}">
          <button type="button" class="spf-icon-btn" data-action="levelUp" data-tooltip="{{localize 'SIMPLYSF2E.Generator.LevelUp'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.LevelUp'}}">
            <i aria-hidden="true" class="fa-solid fa-plus"></i>
          </button>
        </div>
      </div>
      <div class="form-group">
        <label for="spf-itemforge-rarity">{{localize "SIMPLYSF2E.Generator.Rarity"}}</label>
        <select id="spf-itemforge-rarity" name="rarity">
          {{#each rarities}}
            <option value="{{this.value}}" {{#if (eq this.value @root.input.rarity)}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    <div class="spf-generate-row">
      <button type="button" class="{{#if preview}}spf-secondary{{else}}spf-primary{{/if}}" data-action="generate" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-bolt"></i>
        {{#if preview}}{{localize "SIMPLYSF2E.Generator.GenerateAnotherVersion"}}{{else}}{{localize "SIMPLYSF2E.Generator.Generate"}}{{/if}}
      </button>
    </div>
  </fieldset>

  {{#if unavailableNote}}
    <p class="notification warning" role="status">{{unavailableNote}}</p>
  {{/if}}

  {{#if busy}}{{> simplysf2e-progress}}{{/if}}

  {{#if error}}
    <div class="spf-error-notice notification error">
      <p role="alert">{{error}}</p>
      {{#if canReportBug}}
      <button type="button" class="spf-secondary spf-bug-report" data-action="copyBugReport" data-tooltip="{{localize 'SIMPLYSF2E.BugReport.Tooltip'}}">
        <i aria-hidden="true" class="fa-solid fa-bug"></i> {{localize "SIMPLYSF2E.BugReport.Copy"}}
      </button>
      {{/if}}
    </div>
  {{/if}}

  {{#if showEmptyState}}
    <p class="spf-empty">{{localize "SIMPLYSF2E.ItemForge.EmptyHint"}}</p>
  {{/if}}

  {{#if preview}}
  <section class="spf-preview spf-card" aria-label="{{preview.concept.name}}">
    <header class="spf-statblock-header">
      <h2>{{preview.concept.name}}</h2>
      <span class="spf-level">{{localize "SIMPLYSF2E.ItemForge.Item"}} {{preview.concept.level}}</span>
    </header>
    <div class="spf-traits">
      {{#each preview.traits}}<span class="spf-trait">{{this}}</span>{{/each}}
    </div>

    {{#if preview.runed}}
      <div class="spf-statline">
        <span><strong>{{localize "SIMPLYSF2E.ItemForge.Price"}}</strong> {{preview.price}}</span>
        {{#if preview.gradeLabel}}<span><strong>{{localize "SIMPLYSF2E.ItemForge.Grade"}}</strong> {{preview.gradeLabel}}</span>{{/if}}
      </div>

      {{#if preview.upgrades}}
        <h3>{{localize "SIMPLYSF2E.ItemForge.RunesHeading"}}</h3>
        <ul class="spf-list">
          {{#each preview.upgrades}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      {{else}}{{#if preview.propertyRunes}}
        <h3>{{localize "SIMPLYSF2E.ItemForge.RunesHeading"}}</h3>
        <ul class="spf-list">
          {{#each preview.propertyRunes}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      {{/if}}{{/if}}
      {{#if preview.skippedNote}}
        <p class="notification warning" role="status">{{preview.skippedNote}}</p>
      {{/if}}
    {{else}}
      <div class="spf-statline">
        <span><strong>{{localize "SIMPLYSF2E.ItemForge.Usage"}}</strong> {{preview.usage}}{{#if preview.invested}} ({{localize "SIMPLYSF2E.ItemForge.Invested"}}){{/if}}</span>
        <span><strong>{{localize "SIMPLYSF2E.ItemForge.Bulk"}}</strong> {{preview.bulk}}</span>
        <span><strong>{{localize "SIMPLYSF2E.ItemForge.Price"}}</strong> {{preview.price}}</span>
      </div>

      {{#if preview.hasEffects}}
        <h3>{{localize "SIMPLYSF2E.ItemForge.EffectsHeading"}}</h3>
        <ul class="spf-list">
          {{#each preview.effects}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      {{else}}
        {{#unless preview.activation}}
          <p class="notification warning" role="status">{{localize "SIMPLYSF2E.ItemForge.NoEffects"}}</p>
        {{/unless}}
      {{/if}}

      {{#if preview.activation}}
        <h3>{{localize "SIMPLYSF2E.ItemForge.ActivationHeading"}}</h3>
        <ul class="spf-list">
          {{!-- describeActivation() returns plain text; Handlebars escapes it. --}}
          <li>{{preview.activation}}</li>
        </ul>
      {{/if}}
    {{/if}}

    {{#if preview.concept.description}}
      <h3>{{localize "SIMPLYSF2E.Preview.Description"}}</h3>
      <p class="spf-description">{{preview.concept.description}}</p>
    {{/if}}

    {{#if tokenReport}}
      {{! Collapsed by default: the summary always carries the run total and the
          cost line (incl. its "at least" / ≈ wording); the per-step report is one click away. }}
      <details class="spf-token-report spf-disclosure">
        <summary>
          <span class="spf-disclosure-label spf-token-line">
            <span class="spf-token-heading">{{localize "SIMPLYSF2E.Tokens.Heading"}}</span>
            <span class="spf-token-total">{{tokenReport.totalText}}</span>
            {{#if tokenReport.costText}}<span class="spf-token-cost">{{tokenReport.costText}}</span>{{/if}}
          </span>
        </summary>
        <ul class="spf-token-steps">
          {{#each tokenReport.steps}}<li><strong>{{this.label}}</strong> — {{this.text}}</li>{{/each}}
        </ul>
      </details>
    {{/if}}

    <footer class="spf-actions">
      <button type="button" class="spf-primary" data-action="createItem" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-box-open"></i> {{localize "SIMPLYSF2E.ItemForge.CreateItem"}}
      </button>
      <button type="button" class="spf-danger" data-action="discard" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-trash"></i> {{localize "SIMPLYSF2E.Generator.Discard"}}
      </button>
    </footer>
  </section>
  {{/if}}
</div>
