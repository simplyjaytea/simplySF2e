<fieldset class="spf-inputs spf-card" {{#if busy}}disabled{{/if}}>
  <legend>{{localize "SIMPLYSF2E.Treasure.ConceptLegend"}}</legend>
  <div class="spf-row spf-treasure-optionrow">
    <div class="form-group">
      <label for="spf-treasure-level">{{localize "SIMPLYSF2E.Treasure.Level"}}</label>
      <div class="spf-level-controls">
        <button type="button" class="spf-icon-btn" data-action="levelDown" data-tooltip="{{localize 'SIMPLYSF2E.Generator.LevelDown'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.LevelDown'}}">
          <i aria-hidden="true" class="fa-solid fa-minus"></i>
        </button>
        <input id="spf-treasure-level" type="number" name="level" min="{{minLevel}}" max="{{maxLevel}}" step="1" value="{{input.level}}">
        <button type="button" class="spf-icon-btn" data-action="levelUp" data-tooltip="{{localize 'SIMPLYSF2E.Generator.LevelUp'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.LevelUp'}}">
          <i aria-hidden="true" class="fa-solid fa-plus"></i>
        </button>
      </div>
    </div>
    <div class="form-group">
      <label for="spf-treasure-party-size">{{localize "SIMPLYSF2E.Generator.PartySize"}}</label>
      <div class="spf-level-controls">
        <button type="button" class="spf-icon-btn" data-action="partyDown" data-tooltip="{{localize 'SIMPLYSF2E.Generator.PartySizeDown'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.PartySizeDown'}}">
          <i aria-hidden="true" class="fa-solid fa-minus"></i>
        </button>
        <input id="spf-treasure-party-size" type="number" name="partySize" min="{{minParty}}" max="{{maxParty}}" step="1" value="{{input.partySize}}" aria-describedby="spf-treasure-party-hint">
        <button type="button" class="spf-icon-btn" data-action="partyUp" data-tooltip="{{localize 'SIMPLYSF2E.Generator.PartySizeUp'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.PartySizeUp'}}">
          <i aria-hidden="true" class="fa-solid fa-plus"></i>
        </button>
      </div>
      <p id="spf-treasure-party-hint" class="spf-hint">{{localize "SIMPLYSF2E.Treasure.PartyHint"}}</p>
    </div>
  </div>
  <div class="spf-party-fill">
    <button type="button" class="spf-secondary spf-use-party" data-action="useParty" data-tooltip="{{localize 'SIMPLYSF2E.Party.UseTooltip'}}" {{#if busy}}disabled{{/if}}{{#unless party}} disabled{{/unless}}><i aria-hidden="true" class="fa-solid fa-users"></i> {{localize "SIMPLYSF2E.Party.Use"}}</button>
    <span class="spf-party-note">{{#if party}}{{localize "SIMPLYSF2E.Party.Summary" name=party.name count=party.count level=party.level}}{{else}}{{localize "SIMPLYSF2E.Party.None"}}{{/if}}</span>
  </div>
  <div class="spf-row spf-treasure-optionrow">
    <div class="form-group">
      <label for="spf-treasure-amount">{{localize "SIMPLYSF2E.Treasure.Amount"}}</label>
      <select id="spf-treasure-amount" name="amount">
        {{#each amounts}}
          <option value="{{this.value}}" {{#if (eq this.value @root.input.amount)}}selected{{/if}}>{{localize this.label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <label for="spf-treasure-rarity">{{localize "SIMPLYSF2E.Treasure.Rarity"}}</label>
      <select id="spf-treasure-rarity" name="rarity">
        {{#each rarities}}
          <option value="{{this.value}}" {{#if (eq this.value @root.input.rarity)}}selected{{/if}}>{{localize this.label}}</option>
        {{/each}}
      </select>
    </div>
  </div>
  <div class="form-group stacked">
    <label for="spf-treasure-prompt">{{localize "SIMPLYSF2E.Treasure.Prompt"}}</label>
    <textarea id="spf-treasure-prompt" name="prompt" rows="2" placeholder="{{localize 'SIMPLYSF2E.Treasure.PromptPlaceholder'}}">{{input.prompt}}</textarea>
  </div>
  <div class="spf-generate-row">
    <button type="button" class="{{#if preview}}spf-secondary{{else}}spf-primary{{/if}}" data-action="generate" {{#if busy}}disabled{{/if}}>
      <i aria-hidden="true" class="fa-solid fa-gem"></i>
      {{#if preview}}{{localize "SIMPLYSF2E.Treasure.GenerateAnotherVersion"}}{{else}}{{localize "SIMPLYSF2E.Treasure.Generate"}}{{/if}}
    </button>
  </div>
</fieldset>
