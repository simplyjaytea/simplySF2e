<div class="spf-window-body simplysf2e-whats-new spf-hud">
  <p class="spf-hint"><i class="fa-solid fa-bolt spf-hud-accent" aria-hidden="true"></i> {{#if manual}}{{localize "SIMPLYSF2E.WhatsNew.IntroAll"}}{{else}}{{localize "SIMPLYSF2E.WhatsNew.Intro" version=version}}{{/if}}</p>

  <ul class="spf-whats-new-list">
    {{#each notes}}
      <li class="spf-whats-new-note">
        <strong class="spf-whats-new-title">{{title}}</strong>
        <ul class="spf-whats-new-bullets">
          {{#each bullets}}<li>{{this}}</li>{{/each}}
        </ul>
      </li>
    {{/each}}
  </ul>

  {{! Manual "all notes" view only: older releases fold under one collapsed group.
      The automatic unseen-notes view passes an empty list and looks as before. }}
  {{#if earlierNotes.length}}
    <details class="spf-disclosure spf-whats-new-earlier">
      <summary><span class="spf-disclosure-label">{{localize "SIMPLYSF2E.WhatsNew.Earlier" count=earlierNotes.length}}</span></summary>
      <ul class="spf-whats-new-list">
        {{#each earlierNotes}}
          <li class="spf-whats-new-note">
            <strong class="spf-whats-new-title">{{title}}</strong>
            <ul class="spf-whats-new-bullets">
              {{#each bullets}}<li>{{this}}</li>{{/each}}
            </ul>
          </li>
        {{/each}}
      </ul>
    </details>
  {{/if}}

  <div class="spf-whats-new-broke">
    <strong><i class="fa-solid fa-bug" aria-hidden="true"></i> {{localize "SIMPLYSF2E.WhatsNew.BrokeTitle"}}</strong>
    <span>{{localize "SIMPLYSF2E.WhatsNew.BrokeBody"}}</span>
  </div>

  <footer class="spf-actions spf-hud-actions">
    <button type="button" class="spf-primary" data-action="gotIt">
      <i aria-hidden="true" class="fa-solid fa-check"></i> {{localize "SIMPLYSF2E.WhatsNew.GotIt"}}
    </button>
    <button type="button" data-action="disable">
      <i aria-hidden="true" class="fa-solid fa-bell-slash"></i> {{localize "SIMPLYSF2E.WhatsNew.Disable"}}
    </button>
  </footer>
</div>
