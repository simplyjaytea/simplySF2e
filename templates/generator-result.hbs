{{! Result part of the window: progress, error, previews and the empty
    state. One root element, which takes no box of its own (.spf-part is
    display: contents). }}
<div class="spf-part spf-part-result">
  {{#if busy}}{{> simplysf2e-progress}}{{/if}}

  {{#if error}}
    <div class="spf-error-notice notification error">
      <p role="alert">{{error}}</p>
      {{#if canReportBug}}
      <button type="button" class="spf-secondary spf-bug-report" data-action="copyBugReport" data-tooltip="{{localize 'SIMPLYSF2E.BugReport.Tooltip'}}">
        <i aria-hidden="true" class="fa-solid fa-bug"></i> {{localize "SIMPLYSF2E.BugReport.Copy"}}
      </button>
      {{/if}}
    </div>
  {{/if}}

  {{#if recent}}
  <section class="spf-recent spf-card" aria-labelledby="spf-recent-heading">
    <h3 id="spf-recent-heading" data-tooltip="{{localize 'SIMPLYSF2E.Recent.Hint'}}"><i aria-hidden="true" class="fa-solid fa-clock-rotate-left"></i> {{localize "SIMPLYSF2E.Recent.Heading"}}</h3>
    <ul class="spf-recent-list">
      {{#each recent}}
      <li class="spf-recent-row spf-recent-{{this.mode}}">
        <i aria-hidden="true" class="spf-recent-icon fa-solid {{this.icon}}"></i>
        <span class="spf-recent-text">
          <strong class="spf-recent-name" data-tooltip-text="{{this.name}}">{{this.name}}</strong>
          <span class="spf-recent-detail" data-tooltip-text="{{this.detail}}">{{this.detail}}</span>
        </span>
        <button type="button" class="spf-recent-open" data-action="openRecent" data-recent-id="{{this.id}}" aria-label="{{localize 'SIMPLYSF2E.Recent.OpenAria' name=this.name}}" {{#if @root.busy}}disabled{{/if}}><i aria-hidden="true" class="fa-solid fa-folder-open"></i> {{localize "SIMPLYSF2E.Recent.Open"}}</button>
        <button type="button" class="spf-icon-btn" data-action="forgetRecent" data-recent-id="{{this.id}}" data-tooltip="{{localize 'SIMPLYSF2E.Recent.Remove'}}" aria-label="{{localize 'SIMPLYSF2E.Recent.RemoveAria' name=this.name}}" {{#if @root.busy}}disabled{{/if}}><i aria-hidden="true" class="fa-solid fa-xmark"></i></button>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if created}}
  <section class="spf-preview spf-card" aria-label="{{localize 'SIMPLYSF2E.Generator.CompleteTitle'}}">
    <header class="spf-statblock-header">
      <h2>{{localize "SIMPLYSF2E.Generator.CompleteTitle"}}</h2>
    </header>
    <p>{{#if created.inFolder}}{{#if (eq created.count 1)}}{{localize "SIMPLYSF2E.Generator.CreatedOneInFolder" name=created.name}}{{else}}{{localize "SIMPLYSF2E.Generator.CreatedAll" name=created.name count=created.count}}{{/if}}{{else if (eq created.count 1)}}{{localize "SIMPLYSF2E.Generator.Created" name=created.name}}{{else}}{{localize "SIMPLYSF2E.Generator.CompleteSummary" name=created.name count=created.count}}{{/if}}</p>
    {{#if created.grounding.total}}
      <h3>{{localize "SIMPLYSF2E.Generator.CompletionGrounding"}}</h3>
      <ul class="spf-list">
        {{#each created.grounding.rows}}<li>{{this.text}}</li>{{/each}}
      </ul>
    {{/if}}
    {{#if created.statCheck.failed}}
      <h3>{{localize "SIMPLYSF2E.StatCheck.Heading"}}</h3>
      <p class="spf-hint">{{created.statCheck.failed}}</p>
    {{else if created.statCheck.creatures.length}}
      <div class="spf-stat-check {{#if created.statCheck.problems}}spf-stat-check-attention{{else}}spf-stat-check-ok{{/if}}">
        <h3><i aria-hidden="true" class="fa-solid {{#if created.statCheck.problems}}fa-triangle-exclamation{{else}}fa-circle-check{{/if}}"></i> {{localize "SIMPLYSF2E.StatCheck.Heading"}}</h3>
        {{#each created.statCheck.creatures}}
          <details data-fold="stat-check" {{#if this.problems}}open{{/if}}>
            <summary>{{this.summary}}</summary>
            <ul class="spf-list">
              {{#each this.rows}}<li class="spf-stat-row spf-stat-{{this.status}}">{{this.text}}</li>{{/each}}
            </ul>
          </details>
        {{/each}}
      </div>
    {{/if}}
    {{#if tokenReport}}
      {{! Collapsed by default: the summary always carries the run total and the
          cost line (incl. its "at least" / ≈ wording); the per-step report is one click away. }}
      <details data-fold="tokens" class="spf-token-report spf-disclosure">
        <summary>
          <span class="spf-disclosure-label spf-token-line">
            <span class="spf-token-heading">{{localize "SIMPLYSF2E.Tokens.Heading"}}</span>
            <span class="spf-token-total">{{tokenReport.totalText}}</span>
            {{#if tokenReport.costText}}<span class="spf-token-cost">{{tokenReport.costText}}</span>{{/if}}
          </span>
        </summary>
        <ul class="spf-token-steps">
          {{#each tokenReport.steps}}<li><strong>{{this.label}}</strong> — {{this.text}}</li>{{/each}}
        </ul>
      </details>
    {{/if}}
    <footer class="spf-actions">
      {{#if created.actorId}}<button type="button" class="spf-primary" data-action="openCreatedActor"><i aria-hidden="true" class="fa-solid fa-arrow-up-right-from-square"></i> {{localize "SIMPLYSF2E.Generator.OpenSheet"}}</button>{{/if}}
      <button type="button" data-action="generateAnother"><i aria-hidden="true" class="fa-solid fa-bolt"></i> {{localize "SIMPLYSF2E.Generator.GenerateAnother"}}</button>
    </footer>
  </section>
  {{/if}}

  {{#if showEmptyState}}
    <p class="spf-empty">{{#if reskinMode}}{{#if reskinSource}}{{localize "SIMPLYSF2E.Generator.EmptyHintReskinReady"}}{{else}}{{localize "SIMPLYSF2E.Generator.EmptyHintReskin"}}{{/if}}{{else}}{{localize "SIMPLYSF2E.Generator.EmptyHint"}}{{/if}}</p>
  {{/if}}

  {{#if preview}}
  <section class="spf-preview spf-card">
    <header class="spf-statblock-header">
      <h2>{{preview.concept.name}}</h2>
      <span class="spf-level">{{localize "SIMPLYSF2E.Generator.Creature"}} {{preview.stats.level}}</span>
      {{#if preview.matchSummary}}<span class="spf-level spf-match-summary" data-tooltip="{{localize 'SIMPLYSF2E.Preview.Found'}}"><i aria-hidden="true" class="fa-solid fa-circle-check"></i> {{preview.matchSummary.text}}</span>{{/if}}
    </header>
    {{#if preview.concept.blurb}}<p class="spf-blurb"><em>{{preview.concept.blurb}}</em></p>{{/if}}
    <div class="spf-traits">
      {{#each preview.traits}}<span class="spf-trait">{{this}}</span>{{/each}}
    </div>

    <div class="spf-statline">
      <span><strong>{{localize "SIMPLYSF2E.Preview.Perception"}}</strong> {{preview.display.perception}}{{#if preview.senses}}; {{preview.senses}}{{/if}}</span>
      {{#if preview.languages}}<span><strong>{{localize "SIMPLYSF2E.Preview.Languages"}}</strong> {{preview.languages}}</span>{{/if}}
      {{#if preview.stats.skills.length}}
        <span><strong>{{localize "SIMPLYSF2E.Preview.Skills"}}</strong>
          {{#each preview.display.skills}}{{this.name}} {{this.mod}}{{#unless @last}}, {{/unless}}{{/each}}
        </span>
      {{/if}}
    </div>

    <div class="spf-statgrid">
    <div class="spf-statline spf-defenses">
      <span><strong>{{localize "SIMPLYSF2E.Preview.AC"}}</strong> {{preview.stats.ac}}</span>
      <span><strong>{{localize "SIMPLYSF2E.Preview.Fort"}}</strong> {{preview.display.saves.fortitude}}</span>
      <span><strong>{{localize "SIMPLYSF2E.Preview.Ref"}}</strong> {{preview.display.saves.reflex}}</span>
      <span><strong>{{localize "SIMPLYSF2E.Preview.Will"}}</strong> {{preview.display.saves.will}}</span>
      <span><strong>{{localize "SIMPLYSF2E.Preview.HP"}}</strong> {{preview.stats.hp}}</span>
    </div>
    {{#if preview.iwr.immunities}}<div class="spf-statline"><span><strong>{{localize "SIMPLYSF2E.Preview.Immunities"}}</strong> {{preview.iwr.immunities}}</span></div>{{/if}}
    {{#if preview.iwr.resistances}}<div class="spf-statline"><span><strong>{{localize "SIMPLYSF2E.Preview.Resistances"}}</strong> {{preview.iwr.resistances}}</span></div>{{/if}}
    {{#if preview.iwr.weaknesses}}<div class="spf-statline"><span><strong>{{localize "SIMPLYSF2E.Preview.Weaknesses"}}</strong> {{preview.iwr.weaknesses}}</span></div>{{/if}}
    </div>

    <div class="spf-statline">
      <span><strong>{{localize "SIMPLYSF2E.Preview.Speed"}}</strong> {{preview.speeds}}</span>
    </div>

    <div class="spf-strikes">
      {{#each preview.display.strikes}}
        <div class="spf-strike">
          <strong>{{#if (eq this.type "ranged")}}{{localize "SIMPLYSF2E.Preview.Ranged"}}{{else}}{{localize "SIMPLYSF2E.Preview.Melee"}}{{/if}}</strong>
          {{this.name}} {{this.bonusText}},
          <strong>{{localize "SIMPLYSF2E.Preview.Damage"}}</strong> {{this.damage}} {{this.damageType}}
          {{#if this.average}}{{localize "SIMPLYSF2E.Preview.Average" value=this.average}}{{/if}}
          {{#if this.traits.length}}<span class="spf-strike-traits">({{#each this.traits}}{{this}}{{#unless @last}}, {{/unless}}{{/each}})</span>{{/if}}
        </div>
      {{/each}}
    </div>

    {{#if preview.abilities.length}}
      <h3>{{localize "SIMPLYSF2E.Preview.Abilities"}}</h3>
      <ul class="spf-list">
        {{#each preview.abilities}}
          <li>
            {{! The reroll die sits on the name line, glued to the tag (.spf-pick-tail
                does not wrap), so it never drops under the description. }}
            <strong>{{this.name}}</strong>
            <span class="spf-pick-tail">{{#if this.fromGlossary}}<span class="spf-found" title="{{localize 'SIMPLYSF2E.Preview.FromCompendium'}}"><i aria-hidden="true" class="fa-solid fa-book"></i> {{this.glossaryName}}</span>{{else if this.moduleBuilt}}<span class="spf-custom">{{localize "SIMPLYSF2E.Preview.ModuleBuilt"}}</span>{{else if this.narrative}}<span class="spf-custom">{{localize "SIMPLYSF2E.Preview.NarrativeOnly"}}</span>{{else}}<span class="spf-custom">{{localize "SIMPLYSF2E.Preview.Custom"}}</span>{{/if}}{{#if this.rerollable}}<button type="button" class="spf-icon-btn spf-reroll-pick" data-action="rerollPick" data-kind="ability" data-index="{{this.index}}" data-tooltip="{{localize 'SIMPLYSF2E.Generator.RerollPickTooltip'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.RerollPickLabel' name=this.name}}" {{#if @root.busy}}disabled{{/if}}><i aria-hidden="true" class="fa-solid fa-dice-d20"></i></button>{{/if}}</span>
            {{#unless this.fromGlossary}}{{#if this.description}}<div class="spf-ability-desc">{{this.description}}</div>{{/if}}{{/unless}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if preview.concept.spellcasting}}
      <h3>{{localize "SIMPLYSF2E.Preview.Spells"}}
        <span class="spf-spell-dc">{{localize "SIMPLYSF2E.Preview.DC"}} {{preview.stats.spellDC}}, {{localize "SIMPLYSF2E.Preview.Attack"}} {{preview.display.spellAttack}} ({{preview.concept.spellcasting.tradition}})</span>
      </h3>
      <ul class="spf-list spf-inline">
        {{#each preview.spells}}
          <li class="{{#unless this.found}}spf-dropped{{/unless}}">
            {{this.name}} <span class="spf-rank">({{#if this.rank}}{{localize "SIMPLYSF2E.Preview.Rank"}} {{this.rank}}{{else}}{{localize "SIMPLYSF2E.Preview.Cantrip"}}{{/if}})</span>
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.Found'}}" title="{{localize 'SIMPLYSF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation spf-unmatched" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.NotFound'}}" title="{{localize 'SIMPLYSF2E.Preview.NotFound'}}"></i>{{/if}}
            {{#if this.rerollable}}<button type="button" class="spf-icon-btn spf-reroll-pick" data-action="rerollPick" data-kind="spell" data-index="{{this.index}}" data-tooltip="{{localize 'SIMPLYSF2E.Generator.RerollPickTooltip'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.RerollPickLabel' name=this.name}}" {{#if @root.busy}}disabled{{/if}}><i aria-hidden="true" class="fa-solid fa-dice-d20"></i></button>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if preview.feats.length}}
      <h3>{{localize "SIMPLYSF2E.Preview.Feats"}}</h3>
      <ul class="spf-list spf-inline">
        {{#each preview.feats}}
          <li class="{{#unless this.found}}spf-dropped{{/unless}}">
            {{this.name}}
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.Found'}}" title="{{localize 'SIMPLYSF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation spf-unmatched" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.NotFound'}}" title="{{localize 'SIMPLYSF2E.Preview.NotFound'}}"></i>{{/if}}
            {{#if this.rerollable}}<button type="button" class="spf-icon-btn spf-reroll-pick" data-action="rerollPick" data-kind="feat" data-index="{{this.index}}" data-tooltip="{{localize 'SIMPLYSF2E.Generator.RerollPickTooltip'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.RerollPickLabel' name=this.name}}" {{#if @root.busy}}disabled{{/if}}><i aria-hidden="true" class="fa-solid fa-dice-d20"></i></button>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if preview.equipment.length}}
      <h3>{{localize "SIMPLYSF2E.Preview.Equipment"}}</h3>
      <ul class="spf-list spf-inline">
        {{#each preview.equipment}}
          <li class="{{#unless this.found}}spf-dropped{{/unless}}">
            {{this.name}}
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.Found'}}" title="{{localize 'SIMPLYSF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation spf-unmatched" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.NotFound'}}" title="{{localize 'SIMPLYSF2E.Preview.NotFound'}}"></i>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if preview.loot.length}}
      <h3>{{localize "SIMPLYSF2E.Preview.Loot"}}</h3>
      <ul class="spf-list spf-inline">
        {{#each preview.loot}}
          <li class="{{#unless this.found}}spf-dropped{{/unless}}">
            {{this.name}}
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.Found'}}" title="{{localize 'SIMPLYSF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation spf-unmatched" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.NotFound'}}" title="{{localize 'SIMPLYSF2E.Preview.NotFound'}}"></i>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if preview.concept.description}}
      <h3>{{localize "SIMPLYSF2E.Preview.Description"}}</h3>
      <p class="spf-description">{{preview.concept.description}}</p>
    {{/if}}

    {{#if tokenReport}}
      {{! Collapsed by default: the summary always carries the run total and the
          cost line (incl. its "at least" / ≈ wording); the per-step report is one click away. }}
      <details data-fold="tokens" class="spf-token-report spf-disclosure">
        <summary>
          <span class="spf-disclosure-label spf-token-line">
            <span class="spf-token-heading">{{localize "SIMPLYSF2E.Tokens.Heading"}}</span>
            <span class="spf-token-total">{{tokenReport.totalText}}</span>
            {{#if tokenReport.costText}}<span class="spf-token-cost">{{tokenReport.costText}}</span>{{/if}}
          </span>
        </summary>
        <ul class="spf-token-steps">
          {{#each tokenReport.steps}}<li><strong>{{this.label}}</strong> — {{this.text}}</li>{{/each}}
        </ul>
      </details>
    {{/if}}

    <footer class="spf-actions">
      <button type="button" class="spf-primary" data-action="createActor" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-user-plus"></i> {{localize "SIMPLYSF2E.Generator.CreateActor"}}
      </button>
      {{#if preview.loot.length}}
        <button type="button" data-action="rerollLoot" {{#if busy}}disabled{{/if}} data-tooltip="{{localize 'SIMPLYSF2E.Generator.RerollLootTooltip'}}">
          <i aria-hidden="true" class="fa-solid fa-dice-d20"></i> {{localize "SIMPLYSF2E.Generator.RerollLoot"}}
        </button>
      {{/if}}
      <button type="button" class="spf-danger" data-action="discard" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-trash"></i> {{localize "SIMPLYSF2E.Generator.Discard"}}
      </button>
    </footer>
  </section>
  {{/if}}

  {{#if encounterPreview}}
  <section class="spf-preview spf-card spf-encounter">
    <header class="spf-statblock-header">
      <h2>{{encounterPreview.name}}</h2>
      {{! Budget chips: a visible label (XP / Credits) before the numbers, and an
          icon plus screen-reader text when over budget, so colour is never the only cue. }}
      <span class="spf-level spf-budget-chip{{#if encounterPreview.overBudget}} spf-over-budget{{/if}}"><span class="spf-budget-label">{{localize "SIMPLYSF2E.Generator.XPUnit"}}</span> {{encounterPreview.spent}} / {{encounterPreview.budget}}{{#if encounterPreview.overBudget}} <i aria-hidden="true" class="fa-solid fa-triangle-exclamation"></i><span class="spf-sr-only">{{localize "SIMPLYSF2E.Generator.OverBudget"}}</span>{{/if}}</span>
      <span class="spf-level spf-budget-chip{{#if encounterPreview.treasureOverBudget}} spf-over-budget{{/if}}" data-tooltip="{{localize 'SIMPLYSF2E.Generator.TreasureReadoutTooltip'}}"><span class="spf-budget-label">{{localize "SIMPLYSF2E.Generator.CreditsLabel"}}</span> {{encounterPreview.treasureSpent}} / {{encounterPreview.treasureBudget}}{{#if encounterPreview.treasureOverBudget}} <i aria-hidden="true" class="fa-solid fa-triangle-exclamation"></i><span class="spf-sr-only">{{localize "SIMPLYSF2E.Generator.OverBudget"}}</span>{{/if}}</span>
    </header>
    <ul class="spf-encounter-members">
      {{#each encounterPreview.members}}
        <li class="spf-encounter-member {{#if this.skipped}}spf-member-skipped{{/if}}">
          {{! Fixed grid: name and tag on the left, the count stepper always in the
              top-right cell, so it sits in the same place on every card. }}
          <div class="spf-member-head">
            <strong class="spf-member-name">{{this.name}}</strong>
            <span class="spf-member-count">
              <button type="button" class="spf-icon-btn" data-action="memberDown" data-index="{{this.index}}" data-tooltip="{{localize 'SIMPLYSF2E.Generator.MemberDown'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.MemberDown'}}" {{#if @root.busy}}disabled{{/if}}>
                <i aria-hidden="true" class="fa-solid fa-minus"></i>
              </button>
              <span class="spf-member-count-value">×{{this.count}}</span>
              <button type="button" class="spf-icon-btn" data-action="memberUp" data-index="{{this.index}}" data-tooltip="{{localize 'SIMPLYSF2E.Generator.MemberUp'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.MemberUp'}}" {{#if @root.busy}}disabled{{/if}}>
                <i aria-hidden="true" class="fa-solid fa-plus"></i>
              </button>
            </span>
            <span class="spf-member-tag">{{localize "SIMPLYSF2E.Generator.Creature"}} {{this.level}} · {{localize this.role}}{{#if this.skipped}} · <span class="spf-member-skipped-tag">{{localize "SIMPLYSF2E.Generator.MemberSkipped"}}</span>{{/if}}</span>
          </div>
          {{#if this.blurb}}<em class="spf-member-blurb">{{this.blurb}}</em>{{/if}}
          {{! Label/value grid. Abbreviated labels keep their full name for
              assistive tech (visually hidden) and on hover (title). }}
          <dl class="spf-member-stats">
            <div title="{{localize 'SIMPLYSF2E.Preview.ACFull'}}"><dt><span aria-hidden="true">{{localize "SIMPLYSF2E.Preview.AC"}}</span><span class="spf-sr-only">{{localize "SIMPLYSF2E.Preview.ACFull"}}</span></dt><dd>{{this.stats.ac}}</dd></div>
            <div title="{{localize 'SIMPLYSF2E.Preview.HPFull'}}"><dt><span aria-hidden="true">{{localize "SIMPLYSF2E.Preview.HP"}}</span><span class="spf-sr-only">{{localize "SIMPLYSF2E.Preview.HPFull"}}</span></dt><dd>{{this.stats.hp}}</dd></div>
            <div title="{{localize 'SIMPLYSF2E.Preview.Perception'}}"><dt><span aria-hidden="true">{{localize "SIMPLYSF2E.Preview.PerceptionShort"}}</span><span class="spf-sr-only">{{localize "SIMPLYSF2E.Preview.Perception"}}</span></dt><dd>{{this.stats.perception}}</dd></div>
            <div title="{{localize 'SIMPLYSF2E.Preview.FortFull'}}"><dt><span aria-hidden="true">{{localize "SIMPLYSF2E.Preview.Fort"}}</span><span class="spf-sr-only">{{localize "SIMPLYSF2E.Preview.FortFull"}}</span></dt><dd>{{this.stats.fort}}</dd></div>
            <div title="{{localize 'SIMPLYSF2E.Preview.RefFull'}}"><dt><span aria-hidden="true">{{localize "SIMPLYSF2E.Preview.Ref"}}</span><span class="spf-sr-only">{{localize "SIMPLYSF2E.Preview.RefFull"}}</span></dt><dd>{{this.stats.ref}}</dd></div>
            <div><dt>{{localize "SIMPLYSF2E.Preview.Will"}}</dt><dd>{{this.stats.will}}</dd></div>
            {{#if this.stats.strike}}<div class="spf-member-stat-wide"><dt>{{this.stats.strike.name}}</dt><dd>{{this.stats.strike.bonus}} <span class="spf-member-damage">({{this.stats.strike.damage}})</span></dd></div>{{/if}}
            {{#if this.stats.spellDC}}<div class="spf-member-stat-wide"><dt>{{localize "SIMPLYSF2E.Preview.Spells"}} {{localize "SIMPLYSF2E.Preview.DC"}}</dt><dd>{{this.stats.spellDC}}</dd></div>{{/if}}
          </dl>
        </li>
      {{/each}}
    </ul>
    {{#if tokenReport}}
      {{! Collapsed by default: the summary always carries the run total and the
          cost line (incl. its "at least" / ≈ wording); the per-step report is one click away. }}
      <details data-fold="tokens" class="spf-token-report spf-disclosure">
        <summary>
          <span class="spf-disclosure-label spf-token-line">
            <span class="spf-token-heading">{{localize "SIMPLYSF2E.Tokens.Heading"}}</span>
            <span class="spf-token-total">{{tokenReport.totalText}}</span>
            {{#if tokenReport.costText}}<span class="spf-token-cost">{{tokenReport.costText}}</span>{{/if}}
          </span>
        </summary>
        <ul class="spf-token-steps">
          {{#each tokenReport.steps}}<li><strong>{{this.label}}</strong> — {{this.text}}</li>{{/each}}
        </ul>
      </details>
    {{/if}}
    <footer class="spf-actions">
      <button type="button" class="spf-primary" data-action="createActor" {{#if busy}}disabled{{else if encounterPreview.allSkipped}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-users"></i> {{localize "SIMPLYSF2E.Generator.CreateAll"}}
      </button>
      <button type="button" class="spf-danger" data-action="discard" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-trash"></i> {{localize "SIMPLYSF2E.Generator.Discard"}}
      </button>
    </footer>
  </section>
  {{/if}}

  {{#if pcPreview}}
  <section class="spf-preview spf-card spf-character">
    <header class="spf-statblock-header">
      <h2>{{pcPreview.concept.name}}</h2>
      <span class="spf-level">{{localize "SIMPLYSF2E.Generator.Character"}} {{pcPreview.concept.level}}</span>
      {{#if pcPreview.matchSummary}}<span class="spf-level spf-match-summary" data-tooltip="{{localize 'SIMPLYSF2E.Preview.Found'}}"><i aria-hidden="true" class="fa-solid fa-circle-check"></i> {{pcPreview.matchSummary.text}}</span>{{/if}}
    </header>
    {{#if pcPreview.concept.blurb}}<p class="spf-blurb"><em>{{pcPreview.concept.blurb}}</em></p>{{/if}}
    {{#if pcPreview.multiclass}}
      {{#if pcPreview.multiclass.dedication}}
      <p class="spf-multiclass" role="status">{{localize "SIMPLYSF2E.Preview.MulticlassLine" class=pcPreview.multiclass.name dedication=pcPreview.multiclass.dedication}}</p>
      {{else}}
      <p class="notification warning" role="status">{{localize "SIMPLYSF2E.Preview.MulticlassNotPlaced" class=pcPreview.multiclass.name}}</p>
      {{/if}}
    {{/if}}

    <div class="spf-statline">
      <span><strong>{{localize "SIMPLYSF2E.Preview.Ancestry"}}</strong>
        {{pcPreview.ancestry.name}}{{#if pcPreview.ancestry.found}}<i class="fa-solid fa-circle-check spf-match" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.Found'}}" title="{{localize 'SIMPLYSF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation spf-unmatched" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.NotFound'}}" title="{{localize 'SIMPLYSF2E.Preview.NotFound'}}"></i>{{/if}}
      </span>
      {{#if pcPreview.heritage}}
        <span><strong>{{localize "SIMPLYSF2E.Preview.Heritage"}}</strong>
          {{pcPreview.heritage.name}}{{#if pcPreview.heritage.found}}<i class="fa-solid fa-circle-check spf-match" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.Found'}}" title="{{localize 'SIMPLYSF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation spf-unmatched" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.NotFound'}}" title="{{localize 'SIMPLYSF2E.Preview.NotFound'}}"></i>{{/if}}
        </span>
      {{/if}}
      <span><strong>{{localize "SIMPLYSF2E.Preview.Background"}}</strong>
        {{pcPreview.background.name}}{{#if pcPreview.background.found}}<i class="fa-solid fa-circle-check spf-match" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.Found'}}" title="{{localize 'SIMPLYSF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation spf-unmatched" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.NotFound'}}" title="{{localize 'SIMPLYSF2E.Preview.NotFound'}}"></i>{{/if}}
      </span>
      <span><strong>{{localize "SIMPLYSF2E.Preview.Class"}}</strong>
        {{pcPreview.class.name}}{{#if pcPreview.class.found}}<i class="fa-solid fa-circle-check spf-match" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.Found'}}" title="{{localize 'SIMPLYSF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation spf-unmatched" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.NotFound'}}" title="{{localize 'SIMPLYSF2E.Preview.NotFound'}}"></i>{{/if}}
      </span>
    </div>

    <h3>{{localize "SIMPLYSF2E.Skills.Priorities"}}</h3>
    <p>{{#if pcPreview.automaticSkills}}{{localize "SIMPLYSF2E.Skills.Automatic"}}{{else}}{{localize "SIMPLYSF2E.Skills.PreferenceHint"}}{{/if}}</p>
    <ul class="spf-list spf-inline">
      {{#each pcPreview.skillPriorities}}<li>{{this.name}}</li>{{/each}}
    </ul>

    {{#if pcPreview.feats.length}}
      <h3>{{localize "SIMPLYSF2E.Preview.Feats"}}</h3>
      <ul class="spf-list spf-inline">
        {{#each pcPreview.feats}}
          <li class="{{#unless this.found}}{{#unless this.empty}}spf-dropped{{/unless}}{{/unless}}">
            {{this.name}}
            {{#if this.empty}}<i class="fa-solid fa-circle-info" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.EmptyFeatSlot'}}" title="{{localize 'SIMPLYSF2E.Preview.EmptyFeatSlot'}}"></i>{{else if this.found}}<i class="fa-solid fa-circle-check spf-match" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.Found'}}" title="{{localize 'SIMPLYSF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation spf-unmatched" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.NotFound'}}" title="{{localize 'SIMPLYSF2E.Preview.NotFound'}}"></i>{{/if}}
          </li>
        {{/each}}
      </ul>
      {{#if pcPreview.emptyFeatNotice}}<p class="notification warning" role="status">{{pcPreview.emptyFeatNotice}}</p>{{/if}}
    {{/if}}

    {{#if pcPreview.spellcastingNotice}}
      <p class="notification warning" role="status">{{pcPreview.spellcastingNotice}}</p>
    {{/if}}
    {{#if pcPreview.signatureSummary}}
      <p role="status">{{pcPreview.signatureSummary}}</p>
    {{/if}}
    {{#if pcPreview.concept.spellcasting}}
      <h3>{{localize "SIMPLYSF2E.Preview.Spells"}} <span class="spf-spell-dc">({{pcPreview.concept.spellcasting.tradition}})</span></h3>
      <ul class="spf-list spf-inline">
        {{#each pcPreview.spells}}
          <li class="{{#unless this.found}}spf-dropped{{/unless}}">
            {{this.name}} <span class="spf-rank">({{#if this.rank}}{{localize "SIMPLYSF2E.Preview.Rank"}} {{this.rank}}{{else}}{{localize "SIMPLYSF2E.Preview.Cantrip"}}{{/if}})</span>
            {{#if this.signature}}<span class="spf-rank">({{localize "SIMPLYSF2E.Preview.Signature"}})</span>{{/if}}
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.Found'}}" title="{{localize 'SIMPLYSF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation spf-unmatched" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.NotFound'}}" title="{{localize 'SIMPLYSF2E.Preview.NotFound'}}"></i>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if pcPreview.equipment.length}}
      <h3>{{localize "SIMPLYSF2E.Preview.Equipment"}}</h3>
      <ul class="spf-list spf-inline">
        {{#each pcPreview.equipment}}
          <li class="{{#unless this.found}}spf-dropped{{/unless}}">
            {{this.name}}
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.Found'}}" title="{{localize 'SIMPLYSF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation spf-unmatched" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.NotFound'}}" title="{{localize 'SIMPLYSF2E.Preview.NotFound'}}"></i>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if pcPreview.loot.length}}
      <h3>{{localize "SIMPLYSF2E.Preview.Loot"}}</h3>
      <ul class="spf-list spf-inline">
        {{#each pcPreview.loot}}
          <li class="{{#unless this.found}}spf-dropped{{/unless}}">
            {{this.name}}
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.Found'}}" title="{{localize 'SIMPLYSF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation spf-unmatched" role="img" aria-label="{{localize 'SIMPLYSF2E.Preview.NotFound'}}" title="{{localize 'SIMPLYSF2E.Preview.NotFound'}}"></i>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if pcPreview.concept.backstory}}
      <h3>{{localize "SIMPLYSF2E.Preview.Backstory"}}</h3>
      <p class="spf-description">{{pcPreview.concept.backstory}}</p>
    {{/if}}

    {{#if tokenReport}}
      {{! Collapsed by default: the summary always carries the run total and the
          cost line (incl. its "at least" / ≈ wording); the per-step report is one click away. }}
      <details data-fold="tokens" class="spf-token-report spf-disclosure">
        <summary>
          <span class="spf-disclosure-label spf-token-line">
            <span class="spf-token-heading">{{localize "SIMPLYSF2E.Tokens.Heading"}}</span>
            <span class="spf-token-total">{{tokenReport.totalText}}</span>
            {{#if tokenReport.costText}}<span class="spf-token-cost">{{tokenReport.costText}}</span>{{/if}}
          </span>
        </summary>
        <ul class="spf-token-steps">
          {{#each tokenReport.steps}}<li><strong>{{this.label}}</strong> — {{this.text}}</li>{{/each}}
        </ul>
      </details>
    {{/if}}

    <footer class="spf-actions">
      <button type="button" class="spf-primary" data-action="createActor" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-user-plus"></i> {{localize "SIMPLYSF2E.Generator.CreateActor"}}
      </button>
      <button type="button" class="spf-danger" data-action="discard" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-trash"></i> {{localize "SIMPLYSF2E.Generator.Discard"}}
      </button>
    </footer>
  </section>
  {{/if}}
  {{#if reskinPreview}}
  <section class="spf-preview spf-card" aria-label="{{reskinPreview.name}}">
    <header class="spf-statblock-header">
      <h2>{{reskinPreview.name}}</h2>
      <span class="spf-level">{{localize "SIMPLYSF2E.Generator.Creature"}} {{reskinPreview.level}}</span>
    </header>
    <p class="spf-subtitle">{{localize "SIMPLYSF2E.Generator.ReskinBasedOn" name=reskinPreview.sourceName}}</p>
    {{#if reskinPreview.blurb}}<p class="spf-blurb"><em>{{reskinPreview.blurb}}</em></p>{{/if}}
    <p class="notification info" role="note">{{#if reskinPreview.releveled}}{{localize "SIMPLYSF2E.Relevel.Notice" level=reskinPreview.level}}{{else}}{{localize "SIMPLYSF2E.Generator.ReskinUnchanged"}}{{/if}}</p>
    {{#if reskinPreview.readAloud}}
      <h3>{{localize "SIMPLYSF2E.Generator.ReskinReadAloud"}}</h3>
      <blockquote class="spf-read-aloud"><em>{{reskinPreview.readAloud}}</em></blockquote>
    {{/if}}
    {{#each reskinPreview.paragraphs}}<p>{{this}}</p>{{/each}}
    {{#if reskinPreview.recallKnowledge}}
      <h3>{{localize "SIMPLYSF2E.Generator.ReskinRecall"}}</h3>
      <p>{{reskinPreview.recallKnowledge}}</p>
    {{/if}}
    <h3>{{localize "SIMPLYSF2E.Generator.ReskinRenames"}}</h3>
    {{#if reskinPreview.renames.length}}
      <ul class="spf-list spf-rename-list">
        {{#each reskinPreview.renames}}<li>{{this.from}} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i><span class="spf-sr-only">→</span> <strong>{{this.name}}</strong></li>{{/each}}
      </ul>
    {{else}}
      <p class="spf-hint">{{localize "SIMPLYSF2E.Generator.ReskinNoRenames"}}</p>
    {{/if}}
    {{#if tokenReport}}
      {{! Collapsed by default: the summary always carries the run total and the
          cost line (incl. its "at least" / ≈ wording); the per-step report is one click away. }}
      <details data-fold="tokens" class="spf-token-report spf-disclosure">
        <summary>
          <span class="spf-disclosure-label spf-token-line">
            <span class="spf-token-heading">{{localize "SIMPLYSF2E.Tokens.Heading"}}</span>
            <span class="spf-token-total">{{tokenReport.totalText}}</span>
            {{#if tokenReport.costText}}<span class="spf-token-cost">{{tokenReport.costText}}</span>{{/if}}
          </span>
        </summary>
        <ul class="spf-token-steps">
          {{#each tokenReport.steps}}<li><strong>{{this.label}}</strong> — {{this.text}}</li>{{/each}}
        </ul>
      </details>
    {{/if}}
    <footer class="spf-actions">
      <button type="button" class="spf-primary" data-action="createActor" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-user-plus"></i> {{localize "SIMPLYSF2E.Generator.CreateReskin"}}
      </button>
      <button type="button" class="spf-danger" data-action="discard" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-trash"></i> {{localize "SIMPLYSF2E.Generator.Discard"}}
      </button>
    </footer>
  </section>
  {{/if}}
  {{#if characterReview}}
  <section class="spf-preview spf-card" aria-label="{{localize 'SIMPLYSF2E.Generator.ReviewTitle'}}">
    <header class="spf-statblock-header">
      <h2>{{localize "SIMPLYSF2E.Generator.ReviewTitle"}}</h2>
    </header>
    <p class="spf-subtitle">{{characterReview.actorName}}</p>
    {{! The snapshot caveat appears once; each warning below is a short action
        title with its full explanation one click away. Every warning stays in
        the list (and in the status region); none is dropped or merged. }}
    <p class="spf-review-caveat"><i aria-hidden="true" class="fa-solid fa-circle-info"></i> <span>{{localize "SIMPLYSF2E.Skills.Snapshot"}}</span></p>
    {{#if characterReview.actionCount}}
    <div class="spf-review-actions" role="status">
      <h3><i aria-hidden="true" class="fa-solid fa-triangle-exclamation"></i> {{localize "SIMPLYSF2E.Generator.ReviewActionsHeading" count=characterReview.actionCount}}</h3>
      <ul class="spf-review-list">
        {{#each characterReview.choices}}
          <li><details data-fold="review-action" class="spf-disclosure spf-review-action">
            <summary><span class="spf-disclosure-label">{{localize "SIMPLYSF2E.Generator.ReviewChoiceTitle" item=this.itemName}}</span></summary>
            <p><em class="spf-review-prompt">{{localize this.prompt}}</em> {{localize "SIMPLYSF2E.Generator.ReviewChoiceDetail"}}</p>
          </details></li>
        {{/each}}
        {{#each characterReview.skills.warnings}}
          <li><details data-fold="review-action" class="spf-disclosure spf-review-action">
            <summary><span class="spf-disclosure-label">{{this.title}}</span></summary>
            <p>{{this.detail}}</p>
          </details></li>
        {{/each}}
        {{#each characterReview.skills.loadoutWarnings}}
          <li><details data-fold="review-action" class="spf-disclosure spf-review-action">
            <summary><span class="spf-disclosure-label">{{this.title}}</span></summary>
            <p>{{this.detail}}</p>
          </details></li>
        {{/each}}
        {{#if characterReview.incomplete}}
          <li><details data-fold="review-action" class="spf-disclosure spf-review-action">
            <summary><span class="spf-disclosure-label">{{localize "SIMPLYSF2E.Generator.ReviewIncompleteTitle"}}</span></summary>
            <p>{{localize "SIMPLYSF2E.Generator.ReviewIncomplete"}}</p>
          </details></li>
        {{/if}}
      </ul>
    </div>
    {{/if}}
    {{#if characterReview.skills}}
      <h3>{{localize "SIMPLYSF2E.Skills.Result"}}</h3>
      {{#if characterReview.skills.automatic}}<p class="spf-hint">{{localize "SIMPLYSF2E.Skills.Automatic"}}</p>{{/if}}
      {{#if characterReview.skills.budget}}<p class="spf-hint">{{characterReview.skills.budget}}</p>{{/if}}
      <ul class="spf-list spf-inline">
        {{#each characterReview.skills.rows}}<li>{{this.name}} — {{this.rank}}</li>{{/each}}
      </ul>
    {{/if}}
    <footer class="spf-actions">
      <button type="button" class="spf-primary" data-action="openReviewedCharacter"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> {{localize "SIMPLYSF2E.Generator.OpenCharacter"}}</button>
      <button type="button" data-action="dismissCharacterReview"><i class="fa-solid fa-xmark" aria-hidden="true"></i> {{localize "SIMPLYSF2E.Generator.DismissReview"}}</button>
    </footer>
  </section>
  {{/if}}
</div>
