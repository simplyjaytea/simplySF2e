<div class="simplysf2e-manage-presets spf-hud">
  {{#if presets.length}}
    <ul class="spf-manage-list spf-card spf-hud-list">
      {{#each presets}}
        <li>
          <span class="spf-manage-name" title="{{this.name}}">{{this.name}}</span>
          <span class="spf-manage-buttons">
            <button type="button" class="spf-icon-btn" data-action="editPreset" data-id="{{this.id}}" data-tooltip="{{localize 'SIMPLYSF2E.Presets.EditTooltip'}}" aria-label="{{localize 'SIMPLYSF2E.Presets.EditAria' name=this.name}}">
              <i aria-hidden="true" class="fa-solid fa-pen"></i>
            </button>
            <button type="button" class="spf-icon-btn" data-action="duplicatePreset" data-id="{{this.id}}" data-tooltip="{{localize 'SIMPLYSF2E.Presets.DuplicateTooltip'}}" aria-label="{{localize 'SIMPLYSF2E.Presets.DuplicateAria' name=this.name}}">
              <i aria-hidden="true" class="fa-solid fa-copy"></i>
            </button>
            <button type="button" class="spf-icon-btn" data-action="exportPreset" data-id="{{this.id}}" data-tooltip="{{localize 'SIMPLYSF2E.Presets.ExportTooltip'}}" aria-label="{{localize 'SIMPLYSF2E.Presets.ExportAria' name=this.name}}">
              <i aria-hidden="true" class="fa-solid fa-file-export"></i>
            </button>
            <button type="button" class="spf-icon-btn" data-action="deletePreset" data-id="{{this.id}}" data-tooltip="{{localize 'SIMPLYSF2E.Presets.DeleteTooltip'}}" aria-label="{{localize 'SIMPLYSF2E.Presets.DeleteAria' name=this.name}}">
              <i aria-hidden="true" class="fa-solid fa-trash"></i>
            </button>
          </span>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="spf-empty spf-hud-empty"><i class="fa-solid fa-satellite-dish" aria-hidden="true"></i> {{localize "SIMPLYSF2E.Presets.ManageEmpty"}}</p>
  {{/if}}

  <footer class="spf-actions spf-hud-actions">
    <button type="button" class="spf-primary" data-action="newPreset">
      <i aria-hidden="true" class="fa-solid fa-plus"></i> {{localize "SIMPLYSF2E.Presets.New"}}
    </button>
    <button type="button" data-action="exportAll" {{#unless presets.length}}disabled{{/unless}}>
      <i aria-hidden="true" class="fa-solid fa-file-export"></i> {{localize "SIMPLYSF2E.Presets.ExportAll"}}
    </button>
    <button type="button" data-action="importPresets">
      <i aria-hidden="true" class="fa-solid fa-file-import"></i> {{localize "SIMPLYSF2E.Presets.Import"}}
    </button>
  </footer>
</div>
