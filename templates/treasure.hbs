<div class="spf-window-body simplysf2e-generator simplysf2e-treasure spf-hud">
  {{> simplysf2e-statusbar appId="treasure" hideLastRunWithReport=true sourcesDetail=(localize "SIMPLYSF2E.Treasure.SourcesDetail")}}

  <fieldset class="spf-inputs spf-card" {{#if busy}}disabled{{/if}}>
    <legend>{{localize "SIMPLYSF2E.Treasure.ConceptLegend"}}</legend>
    <div class="spf-row spf-treasure-optionrow">
      <div class="form-group">
        <label for="spf-treasure-level">{{localize "SIMPLYSF2E.Treasure.Level"}}</label>
        <div class="spf-level-controls">
          <button type="button" class="spf-icon-btn" data-action="levelDown" data-tooltip="{{localize 'SIMPLYSF2E.Generator.LevelDown'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.LevelDown'}}">
            <i aria-hidden="true" class="fa-solid fa-minus"></i>
          </button>
          <input id="spf-treasure-level" type="number" name="level" min="{{minLevel}}" max="{{maxLevel}}" step="1" value="{{input.level}}">
          <button type="button" class="spf-icon-btn" data-action="levelUp" data-tooltip="{{localize 'SIMPLYSF2E.Generator.LevelUp'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.LevelUp'}}">
            <i aria-hidden="true" class="fa-solid fa-plus"></i>
          </button>
        </div>
      </div>
      <div class="form-group">
        <label for="spf-treasure-party-size">{{localize "SIMPLYSF2E.Generator.PartySize"}}</label>
        <div class="spf-level-controls">
          <button type="button" class="spf-icon-btn" data-action="partyDown" data-tooltip="{{localize 'SIMPLYSF2E.Generator.PartySizeDown'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.PartySizeDown'}}">
            <i aria-hidden="true" class="fa-solid fa-minus"></i>
          </button>
          <input id="spf-treasure-party-size" type="number" name="partySize" min="{{minParty}}" max="{{maxParty}}" step="1" value="{{input.partySize}}" aria-describedby="spf-treasure-party-hint">
          <button type="button" class="spf-icon-btn" data-action="partyUp" data-tooltip="{{localize 'SIMPLYSF2E.Generator.PartySizeUp'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.PartySizeUp'}}">
            <i aria-hidden="true" class="fa-solid fa-plus"></i>
          </button>
        </div>
        <p id="spf-treasure-party-hint" class="spf-hint">{{localize "SIMPLYSF2E.Treasure.PartyHint"}}</p>
      </div>
    </div>
    <div class="spf-party-fill">
      <button type="button" class="spf-secondary spf-use-party" data-action="useParty" data-tooltip="{{localize 'SIMPLYSF2E.Party.UseTooltip'}}" {{#if busy}}disabled{{/if}}{{#unless party}} disabled{{/unless}}><i aria-hidden="true" class="fa-solid fa-users"></i> {{localize "SIMPLYSF2E.Party.Use"}}</button>
      <span class="spf-party-note">{{#if party}}{{localize "SIMPLYSF2E.Party.Summary" name=party.name count=party.count level=party.level}}{{else}}{{localize "SIMPLYSF2E.Party.None"}}{{/if}}</span>
    </div>
    <div class="spf-row spf-treasure-optionrow">
      <div class="form-group">
        <label for="spf-treasure-amount">{{localize "SIMPLYSF2E.Treasure.Amount"}}</label>
        <select id="spf-treasure-amount" name="amount">
          {{#each amounts}}
            <option value="{{this.value}}" {{#if (eq this.value @root.input.amount)}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group">
        <label for="spf-treasure-rarity">{{localize "SIMPLYSF2E.Treasure.Rarity"}}</label>
        <select id="spf-treasure-rarity" name="rarity">
          {{#each rarities}}
            <option value="{{this.value}}" {{#if (eq this.value @root.input.rarity)}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    <div class="form-group stacked">
      <label for="spf-treasure-prompt">{{localize "SIMPLYSF2E.Treasure.Prompt"}}</label>
      <textarea id="spf-treasure-prompt" name="prompt" rows="2" placeholder="{{localize 'SIMPLYSF2E.Treasure.PromptPlaceholder'}}">{{input.prompt}}</textarea>
    </div>
    <div class="spf-generate-row">
      <button type="button" class="{{#if preview}}spf-secondary{{else}}spf-primary{{/if}}" data-action="generate" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-gem"></i>
        {{#if preview}}{{localize "SIMPLYSF2E.Treasure.GenerateAnotherVersion"}}{{else}}{{localize "SIMPLYSF2E.Treasure.Generate"}}{{/if}}
      </button>
    </div>
  </fieldset>

  {{#if busy}}{{> simplysf2e-progress}}{{/if}}

  {{#if error}}
    <div class="spf-error-notice notification error">
      <p role="alert">{{error}}</p>
      {{#if canReportBug}}
      <button type="button" class="spf-secondary spf-bug-report" data-action="copyBugReport" data-tooltip="{{localize 'SIMPLYSF2E.BugReport.Tooltip'}}">
        <i aria-hidden="true" class="fa-solid fa-bug"></i> {{localize "SIMPLYSF2E.BugReport.Copy"}}
      </button>
      {{/if}}
    </div>
  {{/if}}

  {{#if showEmptyState}}
    <p class="spf-empty">{{localize "SIMPLYSF2E.Treasure.EmptyHint"}}</p>
  {{/if}}

  {{#if preview}}
  <section class="spf-preview spf-card" aria-label="{{preview.concept.name}}">
    <header class="spf-statblock-header">
      <h2>{{preview.concept.name}}</h2>
      <span class="spf-level">{{localize "SIMPLYSF2E.Treasure.HoardLevel" level=preview.level}}</span>
    </header>
    <p class="spf-treasure-budget"><strong>{{localize "SIMPLYSF2E.Treasure.BudgetLabel"}}</strong>
      {{#if (eq preview.amount "level")}}{{localize "SIMPLYSF2E.Treasure.BudgetLevel" budget=preview.budget}}{{else}}{{localize "SIMPLYSF2E.Treasure.BudgetEncounter" budget=preview.budget}}{{/if}}
      <span class="spf-treasure-each">{{localize "SIMPLYSF2E.Treasure.Each" each=preview.each count=preview.partySize}}</span>
    </p>

    <h3>{{localize "SIMPLYSF2E.Treasure.ItemsHeading" count=preview.count}}</h3>
    <div class="spf-table-wrap spf-treasure-items-wrap">
      <table class="spf-table spf-treasure-items">
        <thead>
          <tr>
            <th scope="col">{{localize "SIMPLYSF2E.Treasure.ColItem"}}</th>
            {{! Narrow windows show "Lvl"; the full label stays for assistive tech. }}
            <th scope="col" class="spf-num"><span class="spf-col-full">{{localize "SIMPLYSF2E.Treasure.ColLevel"}}</span><span class="spf-col-short" aria-hidden="true">{{localize "SIMPLYSF2E.Treasure.ColLevelShort"}}</span></th>
            <th scope="col" class="spf-num">{{localize "SIMPLYSF2E.Treasure.ColPrice"}}</th>
            <th scope="col"><span class="spf-sr-only">{{localize "SIMPLYSF2E.Treasure.ColRemove"}}</span></th>
          </tr>
        </thead>
        <tbody>
          {{#each preview.rows}}
          <tr>
            <th scope="row"><span class="spf-item-name">{{this.name}}</span>{{#if this.rarity}} <span class="spf-trait spf-treasure-rarity">{{this.rarity}}</span>{{/if}}</th>
            <td class="spf-num">{{this.level}}</td>
            <td class="spf-num">{{this.price}}</td>
            <td>
              <button type="button" class="spf-icon-btn" data-action="removeItem" data-key="{{this.key}}" data-tooltip="{{localize 'SIMPLYSF2E.Treasure.Remove'}}" aria-label="{{localize 'SIMPLYSF2E.Treasure.RemoveItem' name=this.name}}" {{#if @root.busy}}disabled{{/if}}>
                <i aria-hidden="true" class="fa-solid fa-xmark"></i>
              </button>
            </td>
          </tr>
          {{/each}}
          {{#if preview.hasLeftover}}
          <tr class="spf-treasure-credits">
            <th scope="row"><i aria-hidden="true" class="fa-solid fa-credit-card"></i> {{localize "SIMPLYSF2E.Treasure.CreditsRow"}}</th>
            <td class="spf-num">&mdash;</td>
            <td class="spf-num">{{preview.leftover}}</td>
            <td></td>
          </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
    {{#unless preview.hasItems}}
      <p class="notification warning" role="status">{{localize "SIMPLYSF2E.Treasure.AllRemoved"}}</p>
    {{/unless}}
    {{#if preview.dropped}}
      <p class="spf-hint">{{localize "SIMPLYSF2E.Treasure.Dropped" count=preview.dropped}}</p>
    {{/if}}

    {{#if preview.concept.description}}
      <h3>{{localize "SIMPLYSF2E.Preview.Description"}}</h3>
      <p class="spf-description">{{preview.concept.description}}</p>
    {{/if}}

    {{#if tokenReport}}
      {{! Collapsed by default: the summary always carries the run total and the
          cost line (incl. its "at least" / ≈ wording); the per-step report is one click away. }}
      <details class="spf-token-report spf-disclosure">
        <summary>
          <span class="spf-disclosure-label spf-token-line">
            <span class="spf-token-heading">{{localize "SIMPLYSF2E.Tokens.Heading"}}</span>
            <span class="spf-token-total">{{tokenReport.totalText}}</span>
            {{#if tokenReport.costText}}<span class="spf-token-cost">{{tokenReport.costText}}</span>{{/if}}
          </span>
        </summary>
        <ul class="spf-token-steps">
          {{#each tokenReport.steps}}<li><strong>{{this.label}}</strong> — {{this.text}}</li>{{/each}}
        </ul>
      </details>
    {{/if}}

    <footer class="spf-actions">
      <button type="button" class="spf-primary" data-action="createTreasure" {{#if busy}}disabled{{/if}}{{#unless preview.hasItems}}{{#unless preview.hasLeftover}} disabled{{/unless}}{{/unless}}>
        <i aria-hidden="true" class="fa-solid fa-gem"></i> {{localize "SIMPLYSF2E.Treasure.Create"}}
      </button>
      <button type="button" class="spf-danger" data-action="discard" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-trash"></i> {{localize "SIMPLYSF2E.Generator.Discard"}}
      </button>
    </footer>
  </section>
  {{/if}}
</div>
