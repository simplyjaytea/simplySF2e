<div class="spf-window-body simplysf2e-provider-setup spf-hud">
  <p class="spf-hint">{{localize "SIMPLYSF2E.ProviderSetup.Intro"}}</p>

  <fieldset class="spf-card spf-provider-section spf-connection-bank">
    <legend>{{localize "SIMPLYSF2E.ProviderSetup.Connections"}}</legend>
    <label for="spf-active-connection">{{localize "SIMPLYSF2E.ProviderSetup.ActiveConnection"}}</label>
    <div class="spf-connection-row">
      <select id="spf-active-connection" name="activeConnection">
        {{#each connections}}
          <option value="{{this.id}}" {{#if this.active}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
      <button type="button" data-action="createConnection" data-tooltip="{{localize 'SIMPLYSF2E.ProviderSetup.NewConnection'}}" aria-label="{{localize 'SIMPLYSF2E.ProviderSetup.NewConnection'}}">
        <i aria-hidden="true" class="fa-solid fa-plus"></i>
      </button>
      <button type="button" class="spf-danger" data-action="deleteConnection" data-tooltip="{{localize 'SIMPLYSF2E.ProviderSetup.DeleteConnection'}}" aria-label="{{localize 'SIMPLYSF2E.ProviderSetup.DeleteConnection'}}" {{#unless canDeleteConnection}}disabled{{/unless}}>
        <i aria-hidden="true" class="fa-solid fa-trash"></i>
      </button>
    </div>
    <p class="spf-hint">{{localize "SIMPLYSF2E.ProviderSetup.ConnectionsHint"}}</p>
  </fieldset>

  <fieldset class="spf-card spf-provider-section">
    <legend>{{localize "SIMPLYSF2E.ProviderSetup.EndpointLegend"}}</legend>
    <div class="form-group stacked">
      <label for="spf-connection-name">{{localize "SIMPLYSF2E.ProviderSetup.ConnectionName"}}</label>
      <input id="spf-connection-name" type="text" name="connectionName" value="{{connectionName}}" required spellcheck="false" autocomplete="off" placeholder="{{localize 'SIMPLYSF2E.ProviderSetup.ConnectionNamePlaceholder'}}">
    </div>

    <div class="spf-provider-presets" role="group" aria-label="{{localize 'SIMPLYSF2E.ProviderSetup.ChooseProvider'}}">
      {{#each providers}}
        <button type="button" data-action="chooseProvider" data-provider="{{this.id}}" class="{{#if this.selected}}spf-provider-preset-active{{/if}}" aria-pressed="{{#if this.selected}}true{{else}}false{{/if}}">
          <i aria-hidden="true" class="fa-solid {{this.icon}}"></i>
          <span>{{this.label}}</span>
        </button>
      {{/each}}
    </div>
    <p class="spf-hint spf-provider-local-hint" {{#unless showLocalHint}}hidden{{/unless}}><i aria-hidden="true" class="fa-solid fa-server"></i> {{localServerHint}}</p>

    <div class="form-group stacked">
      <label for="spf-provider-base-url">{{localize "SIMPLYSF2E.Settings.ApiBaseUrl.Name"}}</label>
      <input id="spf-provider-base-url" type="url" name="apiBaseUrl" value="{{apiBaseUrl}}" required spellcheck="false" autocomplete="url">
      <p class="spf-hint">{{localize "SIMPLYSF2E.ProviderSetup.BaseUrlHint"}}</p>
    </div>

    <div class="form-group stacked">
      <label for="spf-provider-model">{{localize "SIMPLYSF2E.Settings.Model.Name"}}</label>
      <div class="spf-model-picker">
        <input id="spf-provider-model" type="text" name="model" value="{{model}}" list="spf-provider-model-list" required spellcheck="false" autocomplete="off" placeholder="{{localize 'SIMPLYSF2E.ProviderSetup.ModelPlaceholder'}}">
        <button type="button" data-action="loadModels"><i aria-hidden="true" class="fa-solid fa-rotate"></i> {{localize "SIMPLYSF2E.ProviderSetup.LoadModels"}}</button>
      </div>
      <datalist id="spf-provider-model-list">
        {{#each availableModels}}<option value="{{this}}"></option>{{/each}}
      </datalist>
      <p class="spf-hint">{{localize "SIMPLYSF2E.ProviderSetup.ModelHint"}}</p>
    </div>

  </fieldset>

  <fieldset class="spf-card spf-provider-section">
    <legend>{{localize "SIMPLYSF2E.ProviderSetup.CredentialsLegend"}}</legend>
    <div class="form-group stacked">
      <label for="spf-provider-api-key">{{localize "SIMPLYSF2E.ProviderSetup.ApiKeyLabel"}}</label>
      <input id="spf-provider-api-key" type="password" name="apiKey" value="" spellcheck="false" autocomplete="new-password" placeholder="{{#if hasApiKey}}{{localize 'SIMPLYSF2E.ProviderSetup.ApiKeySaved'}}{{else}}{{localize 'SIMPLYSF2E.ProviderSetup.ApiKeyOptional'}}{{/if}}">
      {{#if hasApiKey}}<p class="spf-hint spf-key-saved">{{localize "SIMPLYSF2E.ProviderSetup.ApiKeySaved"}}</p>{{/if}}
      <p class="spf-hint">{{localize "SIMPLYSF2E.ProviderSetup.ApiKeyHint"}}</p>
    </div>

    {{#if hasApiKey}}
      <label class="spf-provider-clear-key">
        <input type="checkbox" name="clearApiKey">
        {{localize "SIMPLYSF2E.ProviderSetup.ClearApiKey"}}
      </label>
    {{/if}}

    <p class="spf-hint spf-provider-privacy"><i aria-hidden="true" class="fa-solid fa-shield-halved"></i> {{localize "SIMPLYSF2E.ProviderSetup.Privacy"}}</p>
  </fieldset>

  {{! Optional sections fold away. Each opens by itself when it holds a
      validation error (pricesOpen) or the active route needs it (jevOpen:
      TypeSafe chosen or a separate Jev key saved). The summary shows the
      current state so a closed section still reads at a glance. }}
  <details class="spf-card spf-provider-fold spf-disclosure" data-section="prices" {{#if pricesOpen}}open{{/if}}>
    <summary>
      <span class="spf-disclosure-label spf-fold-line">
        <span class="spf-fold-title">{{localize "SIMPLYSF2E.ProviderSetup.CostLegend"}}</span>
        <span class="spf-fold-state">{{#if priceError}}<i aria-hidden="true" class="fa-solid fa-circle-exclamation"></i> {{localize "SIMPLYSF2E.ProviderSetup.FoldNeedsFix"}}{{else if pricesSummary}}{{localize "SIMPLYSF2E.ProviderSetup.CostSummary" input=pricesSummary.input output=pricesSummary.output}}{{else}}{{localize "SIMPLYSF2E.ProviderSetup.CostNotSet"}}{{/if}}</span>
      </span>
    </summary>
    <div class="spf-fold-body">
      <div class="form-group stacked spf-prices" role="group" aria-labelledby="spf-prices-label">
        <span id="spf-prices-label" class="spf-prices-label">{{localize "SIMPLYSF2E.ProviderSetup.PricesLabel"}}</span>
        <div class="spf-price-row">
          <label class="spf-price-field" for="spf-price-input">
            <span>{{localize "SIMPLYSF2E.ProviderSetup.PriceInput"}}</span>
            <input id="spf-price-input" type="number" name="inputPerM" value="{{inputPerM}}" min="0" step="any" inputmode="decimal" placeholder="{{localize 'SIMPLYSF2E.ProviderSetup.PricesPlaceholder'}}"{{#if (eq priceErrorField "input")}} aria-invalid="true" aria-describedby="spf-price-error"{{/if}}>
          </label>
          <label class="spf-price-field" for="spf-price-output">
            <span>{{localize "SIMPLYSF2E.ProviderSetup.PriceOutput"}}</span>
            <input id="spf-price-output" type="number" name="outputPerM" value="{{outputPerM}}" min="0" step="any" inputmode="decimal" placeholder="{{localize 'SIMPLYSF2E.ProviderSetup.PricesPlaceholder'}}"{{#if (eq priceErrorField "output")}} aria-invalid="true" aria-describedby="spf-price-error"{{/if}}>
          </label>
        </div>
        <p id="spf-price-error" class="spf-field-error" data-price-error role="alert" {{#unless priceError}}hidden{{/unless}}><i aria-hidden="true" class="fa-solid fa-circle-exclamation"></i> <span>{{priceError}}</span></p>
        <p class="spf-hint">{{localize "SIMPLYSF2E.ProviderSetup.PricesHint"}}</p>
      </div>
    </div>
  </details>

  <details class="spf-card spf-provider-fold spf-disclosure spf-jev-section" data-section="jev" {{#if jevOpen}}open{{/if}}>
    <summary>
      <span class="spf-disclosure-label spf-fold-line">
        <span class="spf-fold-title">{{localize "SIMPLYSF2E.ProviderSetup.JevLegend"}}</span>
        <span class="spf-fold-state">{{#each jevSources}}{{#if this.selected}}{{this.label}}{{/if}}{{/each}}{{#if hasJevKey}} · {{localize "SIMPLYSF2E.ProviderSetup.JevKeySavedShort"}}{{/if}}</span>
      </span>
    </summary>
    <div class="spf-fold-body">
      <p class="spf-hint">{{localize "SIMPLYSF2E.ProviderSetup.JevHint"}}</p>
      <div class="form-group stacked">
        <label for="spf-jev-source">{{localize "SIMPLYSF2E.ProviderSetup.JevSourceLabel"}}</label>
        <select id="spf-jev-source" name="jevSource">
          {{#each jevSources}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group stacked spf-jev-endpoint" {{#unless jevOnTypeSafe}}hidden{{/unless}}>
        <label for="spf-jev-endpoint">{{localize "SIMPLYSF2E.ProviderSetup.JevEndpointLabel"}}</label>
        <input id="spf-jev-endpoint" type="text" inputmode="url" name="jevEndpoint" value="{{jevEndpoint}}" spellcheck="false" autocomplete="url" placeholder="{{jevDefaultEndpoint}}">
        <p class="spf-hint">{{localize "SIMPLYSF2E.ProviderSetup.JevEndpointHint"}}</p>
      </div>
      <div class="form-group stacked">
        <label for="spf-jev-api-key">{{localize "SIMPLYSF2E.ProviderSetup.JevKeyLabel"}}</label>
        <div class="spf-model-picker">
          <input id="spf-jev-api-key" type="password" name="jevApiKey" value="" spellcheck="false" autocomplete="new-password" placeholder="{{jevKeyPlaceholder}}">
          {{#if hasJevKey}}<p class="spf-hint spf-key-saved">{{localize "SIMPLYSF2E.ProviderSetup.JevKeySaved"}}</p>{{/if}}
          <button type="button" data-action="saveJevKey"><i aria-hidden="true" class="fa-solid fa-bolt"></i> {{localize "SIMPLYSF2E.ProviderSetup.SaveJevKey"}}</button>
          <button type="button" data-action="testJev"><i aria-hidden="true" class="fa-solid fa-signal"></i> {{localize "SIMPLYSF2E.ProviderSetup.TestJev"}}</button>
        </div>
      </div>

      <label class="spf-provider-clear-key spf-jev-clear" {{#unless hasJevKey}}hidden{{/unless}}>
        <input type="checkbox" name="clearJevApiKey">
        {{localize "SIMPLYSF2E.ProviderSetup.ClearJevKey"}}
      </label>

      <p class="notification warning spf-jev-warning" {{#unless jevOnTypeSafe}}hidden{{/unless}}><i aria-hidden="true" class="fa-solid fa-triangle-exclamation"></i> {{localize "SIMPLYSF2E.ProviderSetup.JevCorsWarning"}}</p>
    </div>
  </details>

  <footer class="spf-actions">
    <button type="button" class="spf-primary" data-action="saveAndTest">
      <i aria-hidden="true" class="fa-solid fa-signal"></i> {{localize "SIMPLYSF2E.ProviderSetup.SaveTest"}}
    </button>
    <button type="submit">
      <i aria-hidden="true" class="fa-solid fa-floppy-disk"></i> {{localize "SIMPLYSF2E.ProviderSetup.SaveAuthorize"}}
    </button>
    <button type="button" data-action="cancel">
      <i aria-hidden="true" class="fa-solid fa-xmark"></i> {{localize "SIMPLYSF2E.ProviderSetup.Cancel"}}
    </button>
  </footer>
  <p class="spf-hint spf-footer-hint">{{localize "SIMPLYSF2E.ProviderSetup.FooterHint"}}</p>
</div>
