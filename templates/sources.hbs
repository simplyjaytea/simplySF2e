<div class="spf-window-body simplysf2e-sources spf-hud">
  <p class="spf-hint"><i class="fa-solid fa-satellite-dish spf-hud-accent" aria-hidden="true"></i> {{localize "SIMPLYSF2E.Sources.Hint"}}</p>

  {{#if noPacks}}
    <p class="spf-hint spf-source-empty">{{localize "SIMPLYSF2E.Sources.NonePacksFound"}}</p>
  {{else}}
  {{! Filter bar. Filtering only hides rows (the hidden attribute), client
      side, so unsaved ticks in hidden rows are still submitted, and focus and
      scroll stay where they are. The fields have no name: they are not settings. }}
  <div class="spf-source-filter" role="search" aria-label="{{localize 'SIMPLYSF2E.Sources.FilterLabel'}}">
    <div class="spf-source-filter-row">
      <label for="spf-source-filter" class="spf-source-filter-label"><i aria-hidden="true" class="fa-solid fa-magnifying-glass"></i> <span class="spf-sr-only">{{localize "SIMPLYSF2E.Sources.FilterLabel"}}</span></label>
      <input id="spf-source-filter" type="search" data-source-filter value="{{filter.query}}" placeholder="{{localize 'SIMPLYSF2E.Sources.FilterPlaceholder'}}" autocomplete="off" spellcheck="false" aria-describedby="spf-source-filter-status">
      <label class="spf-source-selected-only"><input type="checkbox" data-source-selected-only {{#if filter.selectedOnly}}checked{{/if}}> {{localize "SIMPLYSF2E.Sources.SelectedOnly"}}</label>
    </div>
    <p id="spf-source-filter-status" class="spf-source-filter-status" data-source-filter-status aria-live="polite" {{#unless filter.active}}hidden{{/unless}}>
      <span data-source-filter-count>{{localize "SIMPLYSF2E.Sources.FilterStatus" shown=filter.shown total=filter.total}}</span>
      <button type="button" class="spf-link-btn" data-source-filter-clear>{{localize "SIMPLYSF2E.Sources.ClearFilter"}}</button>
    </p>
  </div>
  <p class="spf-hint spf-source-no-match" data-source-no-match {{#unless filter.noMatches}}hidden{{/unless}}>{{localize "SIMPLYSF2E.Sources.NoMatches"}}</p>
  {{#each categories}}
    {{! One flat list: each category is a plain heading row over its packs.
        The fieldset and legend stay so screen readers announce the group. }}
    <fieldset class="spf-source-category" data-source-category="{{this.key}}" {{#if this.hidden}}hidden{{/if}}>
      <legend><span class="spf-source-category-label">{{localize this.label}}</span> <span class="spf-source-count" data-source-count>{{localize "SIMPLYSF2E.Sources.CategoryCount" selected=this.selectedCount total=this.packs.length}}</span></legend>
      {{#if this.packs.length}}
        {{#each this.packs}}
          <label class="spf-pack" {{#if this.hidden}}hidden{{/if}}>
            <input type="checkbox" data-category="{{../key}}" data-pack="{{this.id}}" {{#if this.checked}}checked{{/if}}>
            <span class="spf-pack-title">{{this.title}}</span>
            <span class="spf-pack-source">{{this.package}}{{#if this.isDefault}} &middot; {{localize "SIMPLYSF2E.Sources.Default"}}{{/if}}</span>
          </label>
        {{/each}}
      {{else}}
        <p class="spf-hint">{{localize "SIMPLYSF2E.Sources.NonePacksFound"}}</p>
      {{/if}}
    </fieldset>
  {{/each}}
  {{/if}}

  <footer class="spf-actions spf-hud-actions">
    <button type="submit" class="spf-primary" {{#if noPacks}}disabled{{/if}}>
      <i aria-hidden="true" class="fa-solid fa-floppy-disk"></i> {{localize "SIMPLYSF2E.Sources.Save"}}
    </button>
    <button type="button" class="spf-danger" data-action="reset">
      <i aria-hidden="true" class="fa-solid fa-rotate-left"></i> {{localize "SIMPLYSF2E.Sources.Reset"}}
    </button>
  </footer>
</div>
