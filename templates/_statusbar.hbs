{{! Shared status strip of the four tool windows (Generator, Item Forge, Shop,
    Treasure): connection switch, model, last run, readiness rows and the API
    key warning. Callers pass appId (the id prefix of the connection select),
    sourcesDetail (the localized "sources ready" line) and, outside the
    Generator, hideLastRunWithReport=true. Everything else is read from the
    window's own context. Registered in simplysf2e.mjs. }}
<div class="spf-statusbar">
<div class="spf-provider-summary {{#if providerReady}}spf-provider-ready{{else}}spf-provider-attention{{/if}}" data-tooltip="{{providerBaseUrl}}">
  <span class="spf-provider-name">
    <i aria-hidden="true" class="fa-solid {{#if provider.local}}fa-server{{else}}fa-cloud{{/if}}"></i>
    {{#if canSwitchConnection}}
      <label for="spf-{{appId}}-connection" class="spf-sr-only">{{localize "SIMPLYSF2E.ProviderSetup.ActiveConnection"}}</label>
      <select id="spf-{{appId}}-connection" name="activeConnection" {{#if busy}}disabled{{/if}} aria-label="{{localize 'SIMPLYSF2E.ProviderSetup.ActiveConnection'}}">
        {{#each connections}}
          <option value="{{this.id}}" {{#if this.active}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
    {{else}}
      <strong data-tooltip-text="{{#if connectionName}}{{connectionName}}{{else}}{{provider.name}}{{/if}}">{{#if connectionName}}{{connectionName}}{{else}}{{provider.name}}{{/if}}</strong>
    {{/if}}
  </span>
  <code class="spf-provider-model"{{#if provider.model}} data-tooltip-text="{{provider.model}}"{{/if}}>{{#if provider.model}}{{provider.model}}{{else}}{{localize "SIMPLYSF2E.Generator.NoModelShort"}}{{/if}}</code>
  {{! Forge, Shop and Treasure pass hideLastRunWithReport: the preview's own
      Token usage fold shows this same run's total, so the strip copy steps
      aside while that fold is on screen. The Generator always shows it. }}
  {{#if lastRunCost}}{{#if hideLastRunWithReport}}{{#if preview}}{{#unless tokenReport}}<span class="spf-last-run" data-tooltip-text="{{lastRunCost}}">{{lastRunCost}}</span>{{/unless}}{{else}}<span class="spf-last-run" data-tooltip-text="{{lastRunCost}}">{{lastRunCost}}</span>{{/if}}{{else}}<span class="spf-last-run" data-tooltip-text="{{lastRunCost}}">{{lastRunCost}}</span>{{/if}}{{/if}}
  <span class="spf-provider-actions">
    {{#if providerReady}}
      <button type="button" data-action="testProvider" data-tooltip="{{localize 'SIMPLYSF2E.ProviderSetup.TestConnection'}}" aria-label="{{localize 'SIMPLYSF2E.ProviderSetup.TestConnection'}}" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-signal"></i>
      </button>
    {{/if}}
    <button type="button" data-action="configureProvider" data-tooltip="{{localize 'SIMPLYSF2E.ProviderSetup.Configure'}}" aria-label="{{localize 'SIMPLYSF2E.ProviderSetup.Configure'}}" {{#if busy}}disabled{{/if}}>
      <i aria-hidden="true" class="fa-solid fa-gear"></i>
    </button>
    <i class="fa-solid {{#if providerReady}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}} spf-provider-state" role="img" aria-label="{{#if providerReady}}{{localize 'SIMPLYSF2E.Generator.ProviderReady'}}{{else}}{{apiKeyWarning}}{{/if}}" data-tooltip="{{#if providerReady}}{{localize 'SIMPLYSF2E.Generator.ProviderReady'}}{{else}}{{apiKeyWarning}}{{/if}}"></i>
  </span>
</div>
{{! Compendium + Jev readiness. Healthy: one compact row whose details
    expand on click (open state kept per window, like Welcome's Advanced).
    Missing compendium content is a warning: both rows render expanded and
    prominent, never inside a collapsed block. }}
{{#if sourcesReady}}
<details class="spf-readiness spf-disclosure {{#if jevSource}}spf-provider-ready{{else}}spf-provider-off{{/if}}" data-readiness {{#if readinessOpen}}open{{/if}}>
  <summary>
    <span class="spf-disclosure-label spf-readiness-line">
      <span class="spf-readiness-item"><i aria-hidden="true" class="fa-solid fa-book-atlas"></i> {{localize "SIMPLYSF2E.Generator.CompendiumShort"}} <strong class="spf-readiness-ok"><i aria-hidden="true" class="fa-solid fa-circle-check"></i> {{localize "SIMPLYSF2E.Generator.ReadyShort"}}</strong></span>
      <span class="spf-readiness-item"><i aria-hidden="true" class="fa-solid fa-bolt"></i> {{localize "SIMPLYSF2E.Generator.JevShort"}} {{#if jevSource}}<strong class="spf-readiness-ok"><i aria-hidden="true" class="fa-solid fa-circle-check"></i> {{localize "SIMPLYSF2E.Generator.JevShortOn"}}</strong>{{else}}<strong class="spf-readiness-off"><i aria-hidden="true" class="fa-solid fa-circle-minus"></i> {{localize "SIMPLYSF2E.Generator.JevShortOff"}}</strong>{{/if}}</span>
    </span>
  </summary>
  <div class="spf-readiness-detail">
    <div class="spf-provider-summary spf-provider-ready">
      <span class="spf-provider-name"><i aria-hidden="true" class="fa-solid fa-book-atlas"></i> <strong>{{localize "SIMPLYSF2E.Generator.CompendiumContent"}}</strong></span>
      <span class="spf-provider-detail">{{sourcesDetail}}</span>
      <span class="spf-provider-actions"><button type="button" data-action="configureSources" data-tooltip="{{localize 'SIMPLYSF2E.Generator.ConfigureSources'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.ConfigureSources'}}" {{#if busy}}disabled{{/if}}><i aria-hidden="true" class="fa-solid fa-gear"></i></button></span>
    </div>
    <div class="spf-provider-summary {{#if jevSource}}spf-provider-ready{{else}}spf-provider-off{{/if}}">
      <span class="spf-provider-name"><i aria-hidden="true" class="fa-solid fa-bolt"></i> <strong>{{localize "SIMPLYSF2E.Generator.JevRow"}}</strong></span>
      <span class="spf-provider-detail">{{#if (eq jevSource "key")}}{{localize "SIMPLYSF2E.Generator.JevOnKey"}}{{else if (eq jevSource "typesafe")}}{{localize "SIMPLYSF2E.Generator.JevOnTypeSafe"}}{{else if (eq jevSource "connection")}}{{localize "SIMPLYSF2E.Generator.JevOnConnection"}}{{else}}{{localize "SIMPLYSF2E.Generator.JevOff"}}{{/if}}</span>
      <span class="spf-provider-actions"><button type="button" data-action="configureProvider" data-tooltip="{{localize 'SIMPLYSF2E.Generator.JevConfigure'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.JevConfigure'}}" {{#if busy}}disabled{{/if}}><i aria-hidden="true" class="fa-solid fa-gear"></i></button></span>
    </div>
  </div>
</details>
{{else}}
<div class="spf-provider-summary spf-provider-attention">
  <span class="spf-provider-name"><i aria-hidden="true" class="fa-solid fa-book-atlas"></i> <strong>{{localize "SIMPLYSF2E.Generator.CompendiumContent"}}</strong></span>
  <i aria-hidden="true" class="fa-solid fa-triangle-exclamation spf-provider-state"></i>
  <span class="spf-provider-detail" role="status">{{localize "SIMPLYSF2E.Generator.SourcesMissing" categories=sourceMissing}}</span>
  <span class="spf-provider-actions"><button type="button" data-action="configureSources" data-tooltip="{{localize 'SIMPLYSF2E.Generator.ConfigureSources'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.ConfigureSources'}}" {{#if busy}}disabled{{/if}}><i aria-hidden="true" class="fa-solid fa-gear"></i></button></span>
</div>
<div class="spf-provider-summary {{#if jevSource}}spf-provider-ready{{else}}spf-provider-off{{/if}}">
  <span class="spf-provider-name"><i aria-hidden="true" class="fa-solid fa-bolt"></i> <strong>{{localize "SIMPLYSF2E.Generator.JevRow"}}</strong></span>
  <span class="spf-provider-detail">{{#if (eq jevSource "key")}}{{localize "SIMPLYSF2E.Generator.JevOnKey"}}{{else if (eq jevSource "typesafe")}}{{localize "SIMPLYSF2E.Generator.JevOnTypeSafe"}}{{else if (eq jevSource "connection")}}{{localize "SIMPLYSF2E.Generator.JevOnConnection"}}{{else}}{{localize "SIMPLYSF2E.Generator.JevOff"}}{{/if}}</span>
  <span class="spf-provider-actions"><button type="button" data-action="configureProvider" data-tooltip="{{localize 'SIMPLYSF2E.Generator.JevConfigure'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.JevConfigure'}}" {{#if busy}}disabled{{/if}}><i aria-hidden="true" class="fa-solid fa-gear"></i></button></span>
</div>
{{/if}}
</div>
{{#if apiKeyWarning}}
  <p class="notification warning spf-provider-warning" role="status">
    <span>{{apiKeyWarning}}</span>
    {{#if canAuthorizeApiKey}}
      {{! Action first, endpoint detail second: the next step reads first in a narrow window. }}
      <button type="button" data-action="authorizeApiKey" data-base-url="{{providerBaseUrl}}" {{#if busy}}disabled{{/if}}>{{localize "SIMPLYSF2E.Generator.AuthorizeApiKey"}}</button>
      <span class="spf-provider-endpoint"><strong>{{localize "SIMPLYSF2E.Generator.ApiKeyEndpoint"}}</strong> <code>{{providerBaseUrl}}</code></span>
    {{/if}}
  </p>
{{/if}}
