<div class="simplypf2e-generator">
  <div class="spf-provider-summary {{#if providerReady}}spf-provider-ready{{else}}spf-provider-attention{{/if}}" data-tooltip="{{providerBaseUrl}}">
    <span class="spf-provider-name">
      <i class="fa-solid {{#if provider.local}}fa-server{{else}}fa-cloud{{/if}}"></i>
      {{#if canSwitchConnection}}
        <label for="spf-generator-connection" class="spf-sr-only">{{localize "SIMPLYPF2E.ProviderSetup.ActiveConnection"}}</label>
        <select id="spf-generator-connection" name="activeConnection" {{#if busy}}disabled{{/if}} aria-label="{{localize 'SIMPLYPF2E.ProviderSetup.ActiveConnection'}}">
          {{#each connections}}
            <option value="{{this.id}}" {{#if this.active}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      {{else}}
        <strong>{{#if connectionName}}{{connectionName}}{{else}}{{provider.name}}{{/if}}</strong>
      {{/if}}
    </span>
    <code class="spf-provider-model">{{#if provider.model}}{{provider.model}}{{else}}{{localize "SIMPLYPF2E.Generator.NoModelShort"}}{{/if}}</code>
    {{#if lastRunCost}}<span class="spf-last-run">{{lastRunCost}}</span>{{/if}}
    <span class="spf-provider-actions">
      {{#if providerReady}}
        <button type="button" data-action="testProvider" data-tooltip="{{localize 'SIMPLYPF2E.ProviderSetup.TestConnection'}}" aria-label="{{localize 'SIMPLYPF2E.ProviderSetup.TestConnection'}}" {{#if busy}}disabled{{/if}}>
          <i class="fa-solid fa-signal"></i>
        </button>
      {{/if}}
      <button type="button" data-action="configureProvider" data-tooltip="{{localize 'SIMPLYPF2E.ProviderSetup.Configure'}}" aria-label="{{localize 'SIMPLYPF2E.ProviderSetup.Configure'}}" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-gear"></i>
      </button>
      <i class="fa-solid {{#if providerReady}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}} spf-provider-state" role="img" aria-label="{{#if providerReady}}{{localize 'SIMPLYPF2E.Generator.ProviderReady'}}{{else}}{{apiKeyWarning}}{{/if}}" data-tooltip="{{#if providerReady}}{{localize 'SIMPLYPF2E.Generator.ProviderReady'}}{{else}}{{apiKeyWarning}}{{/if}}"></i>
    </span>
  </div>
  {{#if apiKeyWarning}}
    <p class="notification warning spf-provider-warning" role="status">
      <span>{{apiKeyWarning}}</span>
      {{#if canAuthorizeApiKey}}
        <span class="spf-provider-endpoint"><strong>{{localize "SIMPLYPF2E.Generator.ApiKeyEndpoint"}}</strong> <code>{{providerBaseUrl}}</code></span>
        <button type="button" data-action="authorizeApiKey" data-base-url="{{providerBaseUrl}}" {{#if busy}}disabled{{/if}}>{{localize "SIMPLYPF2E.Generator.AuthorizeApiKey"}}</button>
      {{/if}}
    </p>
  {{/if}}
  <div class="spf-provider-summary {{#if sourcesReady}}spf-provider-ready{{else}}spf-provider-attention{{/if}}">
    <span class="spf-provider-name"><i class="fa-solid fa-book-atlas"></i> <strong>{{localize "SIMPLYPF2E.Generator.CompendiumContent"}}</strong></span>
    <span>{{#if sourcesReady}}{{localize "SIMPLYPF2E.Generator.SourcesReady" packCount=sourcePackCount}}{{else}}{{localize "SIMPLYPF2E.Generator.SourcesMissing" categories=sourceMissing}}{{/if}}</span>
    <span class="spf-provider-actions"><button type="button" data-action="configureSources" aria-label="{{localize 'SIMPLYPF2E.Generator.ConfigureSources'}}" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-gear"></i></button></span>
  </div>

  <fieldset class="spf-inputs spf-card" {{#if busy}}disabled{{/if}}>
    <legend>
      {{#if encounterMode}}
        {{localize "SIMPLYPF2E.Generator.EncounterLegend"}}
      {{else if characterMode}}
        {{localize "SIMPLYPF2E.Generator.CharacterLegend"}}
      {{else if npcMode}}
        {{localize "SIMPLYPF2E.Generator.NpcLegend"}}
      {{else}}
        {{localize "SIMPLYPF2E.Generator.ConceptLegend"}}
      {{/if}}
    </legend>
    <div class="spf-mode-toggle" role="radiogroup" aria-label="{{localize 'SIMPLYPF2E.Generator.ModeLabel'}}">
      <label class="{{#if monsterMode}}spf-mode-active{{/if}}">
        <input type="radio" name="mode" value="monster" {{#if monsterMode}}checked{{/if}}>
        <i class="fa-solid fa-dragon"></i> {{localize "SIMPLYPF2E.Mode.Monster"}}
      </label>
      <label class="{{#if npcMode}}spf-mode-active{{/if}}">
        <input type="radio" name="mode" value="npc" {{#if npcMode}}checked{{/if}}>
        <i class="fa-solid fa-user-tie"></i> {{localize "SIMPLYPF2E.Mode.Npc"}}
      </label>
      <label class="{{#if encounterMode}}spf-mode-active{{/if}}">
        <input type="radio" name="mode" value="encounter" {{#if encounterMode}}checked{{/if}}>
        <i class="fa-solid fa-people-group"></i> {{localize "SIMPLYPF2E.Mode.Encounter"}}
      </label>
      <label class="{{#if characterMode}}spf-mode-active{{/if}}">
        <input type="radio" name="mode" value="character" {{#if characterMode}}checked{{/if}}>
        <i class="fa-solid fa-user"></i> {{localize "SIMPLYPF2E.Mode.Character"}}
      </label>
    </div>
    <div class="form-group stacked">
      {{#if encounterMode}}
        <label for="spf-generator-prompt">{{localize "SIMPLYPF2E.Generator.EncounterTheme"}}</label>
        <textarea id="spf-generator-prompt" name="prompt" rows="3" placeholder="{{localize 'SIMPLYPF2E.Generator.EncounterThemePlaceholder'}}">{{input.prompt}}</textarea>
      {{else if characterMode}}
        <label for="spf-generator-prompt">{{localize "SIMPLYPF2E.Generator.CharacterPrompt"}}</label>
        <textarea id="spf-generator-prompt" name="prompt" rows="3" placeholder="{{localize 'SIMPLYPF2E.Generator.CharacterPromptPlaceholder'}}">{{input.prompt}}</textarea>
      {{else if npcMode}}
        <label for="spf-generator-prompt">{{localize "SIMPLYPF2E.Generator.NpcPrompt"}}</label>
        <textarea id="spf-generator-prompt" name="prompt" rows="3" placeholder="{{localize 'SIMPLYPF2E.Generator.NpcPromptPlaceholder'}}">{{input.prompt}}</textarea>
      {{else}}
        <label for="spf-generator-prompt">{{localize "SIMPLYPF2E.Generator.Prompt"}}</label>
        <textarea id="spf-generator-prompt" name="prompt" rows="3" placeholder="{{promptPlaceholder}}">{{input.prompt}}</textarea>
      {{/if}}
    </div>
    <div class="spf-level-primary">
      <div class="form-group">
        <label for="spf-generator-level">{{#if encounterMode}}{{localize "SIMPLYPF2E.Generator.PartyLevel"}}{{else}}{{localize "SIMPLYPF2E.Generator.Level"}}{{/if}}</label>
        <div class="spf-level-controls">
          <button type="button" class="spf-icon-btn" data-action="levelDown" data-tooltip="{{localize 'SIMPLYPF2E.Generator.LevelDown'}}" aria-label="{{localize 'SIMPLYPF2E.Generator.LevelDown'}}">
            <i class="fa-solid fa-minus"></i>
          </button>
          <input id="spf-generator-level" type="number" name="level" min="{{levelMin}}" max="{{levelMax}}" step="1" value="{{input.level}}">
          <button type="button" class="spf-icon-btn" data-action="levelUp" data-tooltip="{{localize 'SIMPLYPF2E.Generator.LevelUp'}}" aria-label="{{localize 'SIMPLYPF2E.Generator.LevelUp'}}">
            <i class="fa-solid fa-plus"></i>
          </button>
        </div>
      </div>
    </div>
    <details class="spf-advanced">
      <summary>{{localize "SIMPLYPF2E.Generator.Advanced"}}</summary>
      <div class="spf-advanced-content">
        {{! One stable slot in every mode: presets guide every pipeline. Creation,
            duplication, export, and deletion live in the dedicated manager. }}
        <div class="form-group spf-preset stacked">
          <label for="spf-generator-preset">{{localize "SIMPLYPF2E.Generator.Preset"}}</label>
          <div class="spf-preset-controls">
            <select id="spf-generator-preset" name="preset" aria-describedby="spf-generator-preset-trust">
              <option value="" {{#if nonePresetSelected}}selected{{/if}}>{{localize "SIMPLYPF2E.Presets.None"}}</option>
              <optgroup label="{{localize 'SIMPLYPF2E.Presets.StandardGroup'}}">
                {{#each standardPresets}}
                  <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
              </optgroup>
              {{#if customPresets.length}}
              <optgroup label="{{localize 'SIMPLYPF2E.Presets.CustomGroup'}}">
                {{#each customPresets}}
                  <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
              </optgroup>
              {{/if}}
            </select>
            <button type="button" data-action="managePresets">
              <i class="fa-solid fa-bookmark" aria-hidden="true"></i> {{localize "SIMPLYPF2E.Presets.Manage"}}
            </button>
          </div>
          <p id="spf-generator-preset-trust" class="spf-hint spf-preset-trust" role="note">{{localize "SIMPLYPF2E.Presets.FlavorGuide"}}</p>
        </div>
        <div class="spf-row">
      {{! Stable shared column order in every mode: Level → Rarity (a cap in
          Character mode) → Treasure amount → Allow spellcasting. The level
          remains prominent above; encounter-specific controls append here. }}
      {{#if characterMode}}
        <div class="form-group">
          <label for="spf-generator-rarity-cap" data-tooltip="{{localize 'SIMPLYPF2E.Generator.RarityCapTooltip'}}">{{localize "SIMPLYPF2E.Generator.RarityCap"}}</label>
          <select id="spf-generator-rarity-cap" name="rarityCap">
            {{#each rarities}}
              <option value="{{this.value}}" {{#if (eq this.value @root.input.rarityCap)}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
          </select>
        </div>
      {{else}}
        <div class="form-group">
          <label for="spf-generator-rarity">{{localize "SIMPLYPF2E.Generator.Rarity"}}</label>
          <select id="spf-generator-rarity" name="rarity">
            {{#each rarities}}
              <option value="{{this.value}}" {{#if (eq this.value @root.input.rarity)}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
          </select>
        </div>
      {{/if}}
      <div class="form-group">
        <label for="spf-generator-treasure-amount">{{localize "SIMPLYPF2E.Generator.TreasureAmount"}}</label>
        <select id="spf-generator-treasure-amount" name="treasureAmount">
          {{#each treasureAmounts}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group spf-checkbox">
        <label>
          <input type="checkbox" name="allowSpellcasting" {{#if input.allowSpellcasting}}checked{{/if}}>
          {{localize "SIMPLYPF2E.Generator.AllowSpellcasting"}}
        </label>
      </div>
      {{#if encounterMode}}
        <div class="form-group">
          <label for="spf-generator-party-size">{{localize "SIMPLYPF2E.Generator.PartySize"}}</label>
          <div class="spf-level-controls">
            <button type="button" class="spf-icon-btn" data-action="partyDown" data-tooltip="{{localize 'SIMPLYPF2E.Generator.PartySizeDown'}}" aria-label="{{localize 'SIMPLYPF2E.Generator.PartySizeDown'}}">
              <i class="fa-solid fa-minus"></i>
            </button>
            <input id="spf-generator-party-size" type="number" name="partySize" min="1" max="8" step="1" value="{{input.partySize}}">
            <button type="button" class="spf-icon-btn" data-action="partyUp" data-tooltip="{{localize 'SIMPLYPF2E.Generator.PartySizeUp'}}" aria-label="{{localize 'SIMPLYPF2E.Generator.PartySizeUp'}}">
              <i class="fa-solid fa-plus"></i>
            </button>
          </div>
        </div>
        <div class="form-group">
          <label for="spf-generator-threat">{{localize "SIMPLYPF2E.Generator.Threat"}}</label>
          <select id="spf-generator-threat" name="threat">
            {{#each threats}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
          </select>
        </div>
      {{/if}}
        </div>
      </div>
    </details>
    <div class="spf-generate-row">
      <button type="button" class="spf-primary" data-action="generate" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-wand-sparkles"></i>
        {{#if monsterMode}}{{localize "SIMPLYPF2E.Generator.GenerateMonster"}}{{else if npcMode}}{{localize "SIMPLYPF2E.Generator.GenerateNpc"}}{{else if encounterMode}}{{localize "SIMPLYPF2E.Generator.GenerateEncounter"}}{{else}}{{localize "SIMPLYPF2E.Generator.GenerateCharacter"}}{{/if}}
      </button>
      <button type="button" class="spf-secondary" data-action="previewPlan" {{#if busy}}disabled{{/if}}>{{localize "SIMPLYPF2E.Generator.PreviewPlan"}}</button>
      <button type="button" class="spf-random-button" data-action="generateRandom" data-tooltip="{{localize randomTooltipKey}}" aria-label="{{localize randomTooltipKey}}" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-dice-d20"></i>
      </button>
    </div>
  </fieldset>

  {{#if busy}}{{> simplypf2e-progress}}{{/if}}

  {{#if error}}
    <p class="notification error" role="alert">{{error}}</p>
  {{/if}}

  {{#if created}}
  <section class="spf-preview spf-card" aria-label="{{localize 'SIMPLYPF2E.Generator.CompleteTitle'}}">
    <h2>{{localize "SIMPLYPF2E.Generator.CompleteTitle"}}</h2>
    <p>{{localize "SIMPLYPF2E.Generator.CompleteSummary" name=created.name count=created.count}}</p>
    {{#if created.grounding.total}}
      <h3>{{localize "SIMPLYPF2E.Generator.CompletionGrounding"}}</h3>
      <ul class="spf-list">
        {{#each created.grounding.rows}}<li>{{this.text}}</li>{{/each}}
      </ul>
    {{/if}}
    {{#if tokenReport}}
      <div class="spf-token-report">
        <h3>{{localize "SIMPLYPF2E.Tokens.Heading"}}</h3>
        <ul>
          {{#each tokenReport.steps}}<li><strong>{{this.label}}</strong> — {{this.text}}</li>{{/each}}
        </ul>
        <p class="spf-token-total">{{tokenReport.totalText}}</p>
      </div>
    {{/if}}
    <footer class="spf-actions">
      {{#if created.actorId}}<button type="button" class="spf-primary" data-action="openCreatedActor"><i class="fa-solid fa-arrow-up-right-from-square"></i> {{localize "SIMPLYPF2E.Generator.OpenSheet"}}</button>{{/if}}
      <button type="button" data-action="generateAnother"><i class="fa-solid fa-wand-sparkles"></i> {{localize "SIMPLYPF2E.Generator.GenerateAnother"}}</button>
    </footer>
  </section>
  {{/if}}

  {{#if showEmptyState}}
    <p class="spf-empty">{{localize "SIMPLYPF2E.Generator.EmptyHint"}}</p>
  {{/if}}

  {{#if preview}}
  <section class="spf-preview spf-card">
    <header class="spf-statblock-header">
      <h2>{{preview.concept.name}}</h2>
      <span class="spf-level">{{localize "SIMPLYPF2E.Generator.Creature"}} {{preview.concept.level}}</span>
      {{#if preview.matchSummary}}<span class="spf-level spf-match-summary" data-tooltip="{{localize 'SIMPLYPF2E.Preview.Found'}}"><i class="fa-solid fa-circle-check"></i> {{preview.matchSummary.text}}</span>{{/if}}
    </header>
    {{#if preview.concept.blurb}}<p class="spf-blurb"><em>{{preview.concept.blurb}}</em></p>{{/if}}
    <div class="spf-traits">
      {{#each preview.traits}}<span class="spf-trait">{{this}}</span>{{/each}}
    </div>

    <div class="spf-statline">
      <span><strong>{{localize "SIMPLYPF2E.Preview.Perception"}}</strong> +{{preview.stats.perception}}{{#if preview.senses}}; {{preview.senses}}{{/if}}</span>
      {{#if preview.languages}}<span><strong>{{localize "SIMPLYPF2E.Preview.Languages"}}</strong> {{preview.languages}}</span>{{/if}}
      {{#if preview.stats.skills.length}}
        <span><strong>{{localize "SIMPLYPF2E.Preview.Skills"}}</strong>
          {{#each preview.stats.skills}}{{this.name}} +{{this.mod}}{{#unless @last}}, {{/unless}}{{/each}}
        </span>
      {{/if}}
    </div>

    <div class="spf-statline spf-defenses">
      <span><strong>AC</strong> {{preview.stats.ac}}</span>
      <span><strong>{{localize "SIMPLYPF2E.Preview.Fort"}}</strong> +{{preview.stats.saves.fortitude}}</span>
      <span><strong>{{localize "SIMPLYPF2E.Preview.Ref"}}</strong> +{{preview.stats.saves.reflex}}</span>
      <span><strong>{{localize "SIMPLYPF2E.Preview.Will"}}</strong> +{{preview.stats.saves.will}}</span>
      <span><strong>HP</strong> {{preview.stats.hp}}</span>
    </div>
    {{#if preview.iwr.immunities}}<div class="spf-statline"><span><strong>{{localize "SIMPLYPF2E.Preview.Immunities"}}</strong> {{preview.iwr.immunities}}</span></div>{{/if}}
    {{#if preview.iwr.resistances}}<div class="spf-statline"><span><strong>{{localize "SIMPLYPF2E.Preview.Resistances"}}</strong> {{preview.iwr.resistances}}</span></div>{{/if}}
    {{#if preview.iwr.weaknesses}}<div class="spf-statline"><span><strong>{{localize "SIMPLYPF2E.Preview.Weaknesses"}}</strong> {{preview.iwr.weaknesses}}</span></div>{{/if}}

    <div class="spf-statline">
      <span><strong>{{localize "SIMPLYPF2E.Preview.Speed"}}</strong> {{preview.speeds}}</span>
    </div>

    <div class="spf-strikes">
      {{#each preview.stats.strikes}}
        <div class="spf-strike">
          <strong>{{#if (eq this.type "ranged")}}{{localize "SIMPLYPF2E.Preview.Ranged"}}{{else}}{{localize "SIMPLYPF2E.Preview.Melee"}}{{/if}}</strong>
          {{this.name}} +{{this.bonus}},
          <strong>{{localize "SIMPLYPF2E.Preview.Damage"}}</strong> {{this.damage}} {{this.damageType}}
          {{#if this.average}}(avg {{this.average}}){{/if}}
          {{#if this.traits.length}}<span class="spf-strike-traits">({{#each this.traits}}{{this}}{{#unless @last}}, {{/unless}}{{/each}})</span>{{/if}}
        </div>
      {{/each}}
    </div>

    {{#if preview.abilities.length}}
      <h3>{{localize "SIMPLYPF2E.Preview.Abilities"}}</h3>
      <ul class="spf-list">
        {{#each preview.abilities}}
          <li>
            <strong>{{this.name}}</strong>
            {{#if this.fromGlossary}}
              <span class="spf-found" title="{{localize 'SIMPLYPF2E.Preview.FromCompendium'}}"><i class="fa-solid fa-book"></i> {{this.glossaryName}}</span>
            {{else if this.narrative}}
              <span class="spf-custom">{{localize "SIMPLYPF2E.Preview.NarrativeOnly"}}</span>
              {{#if this.description}}<div class="spf-ability-desc">{{this.description}}</div>{{/if}}
            {{else}}
              <span class="spf-custom">{{localize "SIMPLYPF2E.Preview.Custom"}}</span>
              {{#if this.description}}<div class="spf-ability-desc">{{this.description}}</div>{{/if}}
            {{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if preview.concept.spellcasting}}
      <h3>{{localize "SIMPLYPF2E.Preview.Spells"}}
        <span class="spf-spell-dc">DC {{preview.stats.spellDC}}, {{localize "SIMPLYPF2E.Preview.Attack"}} +{{preview.stats.spellAttack}} ({{preview.concept.spellcasting.tradition}})</span>
      </h3>
      <ul class="spf-list spf-inline">
        {{#each preview.spells}}
          <li class="{{#unless this.found}}spf-dropped{{/unless}}">
            {{this.name}} <span class="spf-rank">({{#if this.rank}}{{localize "SIMPLYPF2E.Preview.Rank"}} {{this.rank}}{{else}}{{localize "SIMPLYPF2E.Preview.Cantrip"}}{{/if}})</span>
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" title="{{localize 'SIMPLYPF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation" title="{{localize 'SIMPLYPF2E.Preview.NotFound'}}"></i>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if preview.feats.length}}
      <h3>{{localize "SIMPLYPF2E.Preview.Feats"}}</h3>
      <ul class="spf-list spf-inline">
        {{#each preview.feats}}
          <li class="{{#unless this.found}}spf-dropped{{/unless}}">
            {{this.name}}
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" title="{{localize 'SIMPLYPF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation" title="{{localize 'SIMPLYPF2E.Preview.NotFound'}}"></i>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if preview.equipment.length}}
      <h3>{{localize "SIMPLYPF2E.Preview.Equipment"}}</h3>
      <ul class="spf-list spf-inline">
        {{#each preview.equipment}}
          <li>
            {{this.name}}
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" title="{{localize 'SIMPLYPF2E.Preview.Found'}}"></i>{{else}}<span class="spf-custom" title="{{localize 'SIMPLYPF2E.Preview.EquipmentCustom'}}">{{localize "SIMPLYPF2E.Preview.Custom"}}</span>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if preview.loot.length}}
      <h3>{{localize "SIMPLYPF2E.Preview.Loot"}}</h3>
      <ul class="spf-list spf-inline">
        {{#each preview.loot}}
          <li>
            {{this.name}}
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" title="{{localize 'SIMPLYPF2E.Preview.Found'}}"></i>{{else}}<span class="spf-custom" title="{{localize 'SIMPLYPF2E.Preview.LootCustom'}}">{{localize "SIMPLYPF2E.Preview.Custom"}}</span>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if preview.concept.description}}
      <h3>{{localize "SIMPLYPF2E.Preview.Description"}}</h3>
      <p class="spf-description">{{preview.concept.description}}</p>
    {{/if}}

    {{#if tokenReport}}
      <div class="spf-token-report">
        <h3>{{localize "SIMPLYPF2E.Tokens.Heading"}}</h3>
        <ul>
          {{#each tokenReport.steps}}
            <li><strong>{{this.label}}</strong> — {{this.text}}</li>
          {{/each}}
        </ul>
        <p class="spf-token-total">{{tokenReport.totalText}}</p>
      </div>
    {{/if}}

    <footer class="spf-actions">
      <button type="button" class="spf-primary" data-action="createActor" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-user-plus"></i> {{localize "SIMPLYPF2E.Generator.CreateActor"}}
      </button>
      {{#if preview.loot.length}}
        <button type="button" data-action="rerollLoot" {{#if busy}}disabled{{/if}} data-tooltip="{{localize 'SIMPLYPF2E.Generator.RerollLootTooltip'}}">
          <i class="fa-solid fa-dice-d20"></i> {{localize "SIMPLYPF2E.Generator.RerollLoot"}}
        </button>
      {{/if}}
      <button type="button" data-action="discard" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-trash"></i> {{localize "SIMPLYPF2E.Generator.Discard"}}
      </button>
    </footer>
  </section>
  {{/if}}

  {{#if encounterPreview}}
  <section class="spf-preview spf-card spf-encounter">
    <header class="spf-statblock-header">
      <h2>{{encounterPreview.name}}</h2>
      <span class="spf-level {{#if encounterPreview.overBudget}}spf-over-budget{{/if}}">{{encounterPreview.spent}} / {{encounterPreview.budget}} XP</span>
      <span class="spf-level" data-tooltip="{{localize 'SIMPLYPF2E.Generator.TreasureReadoutTooltip'}}">{{encounterPreview.treasureSpent}} / {{encounterPreview.treasureBudget}} gp</span>
    </header>
    <ul class="spf-encounter-members">
      {{#each encounterPreview.members}}
        <li class="spf-encounter-member spf-card {{#if this.skipped}}spf-member-skipped{{/if}}">
          <div class="spf-member-head">
            <strong>{{this.name}}</strong>
            <span class="spf-member-count">
              <button type="button" class="spf-icon-btn" data-action="memberDown" data-index="{{this.index}}" data-tooltip="{{localize 'SIMPLYPF2E.Generator.MemberDown'}}" aria-label="{{localize 'SIMPLYPF2E.Generator.MemberDown'}}" {{#if @root.busy}}disabled{{/if}}>
                <i class="fa-solid fa-minus"></i>
              </button>
              <span class="spf-member-count-value">×{{this.count}}</span>
              <button type="button" class="spf-icon-btn" data-action="memberUp" data-index="{{this.index}}" data-tooltip="{{localize 'SIMPLYPF2E.Generator.MemberUp'}}" aria-label="{{localize 'SIMPLYPF2E.Generator.MemberUp'}}" {{#if @root.busy}}disabled{{/if}}>
                <i class="fa-solid fa-plus"></i>
              </button>
            </span>
            <span class="spf-member-tag">{{localize "SIMPLYPF2E.Generator.Creature"}} {{this.level}} · {{localize this.role}}</span>
          </div>
          {{#if this.blurb}}<em>{{this.blurb}}</em>{{/if}}
          <div class="spf-member-stats">{{this.statline}}</div>
        </li>
      {{/each}}
    </ul>
    {{#if tokenReport}}
      <div class="spf-token-report">
        <h3>{{localize "SIMPLYPF2E.Tokens.Heading"}}</h3>
        <ul>
          {{#each tokenReport.steps}}
            <li><strong>{{this.label}}</strong> — {{this.text}}</li>
          {{/each}}
        </ul>
        <p class="spf-token-total">{{tokenReport.totalText}}</p>
      </div>
    {{/if}}
    <footer class="spf-actions">
      <button type="button" class="spf-primary" data-action="createActor" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-users"></i> {{localize "SIMPLYPF2E.Generator.CreateAll"}}
      </button>
      <button type="button" data-action="discard" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-trash"></i> {{localize "SIMPLYPF2E.Generator.Discard"}}
      </button>
    </footer>
  </section>
  {{/if}}

  {{#if pcPreview}}
  <section class="spf-preview spf-card spf-character">
    <header class="spf-statblock-header">
      <h2>{{pcPreview.concept.name}}</h2>
      <span class="spf-level">{{localize "SIMPLYPF2E.Generator.Character"}} {{pcPreview.concept.level}}</span>
      {{#if pcPreview.matchSummary}}<span class="spf-level spf-match-summary" data-tooltip="{{localize 'SIMPLYPF2E.Preview.Found'}}"><i class="fa-solid fa-circle-check"></i> {{pcPreview.matchSummary.text}}</span>{{/if}}
    </header>
    {{#if pcPreview.concept.blurb}}<p class="spf-blurb"><em>{{pcPreview.concept.blurb}}</em></p>{{/if}}

    <div class="spf-statline">
      <span><strong>{{localize "SIMPLYPF2E.Preview.Ancestry"}}</strong>
        {{pcPreview.ancestry.name}}{{#if pcPreview.ancestry.found}}<i class="fa-solid fa-circle-check spf-match" title="{{localize 'SIMPLYPF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation" title="{{localize 'SIMPLYPF2E.Preview.NotFound'}}"></i>{{/if}}
      </span>
      {{#if pcPreview.heritage}}
        <span><strong>{{localize "SIMPLYPF2E.Preview.Heritage"}}</strong>
          {{pcPreview.heritage.name}}{{#if pcPreview.heritage.found}}<i class="fa-solid fa-circle-check spf-match" title="{{localize 'SIMPLYPF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation" title="{{localize 'SIMPLYPF2E.Preview.NotFound'}}"></i>{{/if}}
        </span>
      {{/if}}
      <span><strong>{{localize "SIMPLYPF2E.Preview.Background"}}</strong>
        {{pcPreview.background.name}}{{#if pcPreview.background.found}}<i class="fa-solid fa-circle-check spf-match" title="{{localize 'SIMPLYPF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation" title="{{localize 'SIMPLYPF2E.Preview.NotFound'}}"></i>{{/if}}
      </span>
      <span><strong>{{localize "SIMPLYPF2E.Preview.Class"}}</strong>
        {{pcPreview.class.name}}{{#if pcPreview.class.found}}<i class="fa-solid fa-circle-check spf-match" title="{{localize 'SIMPLYPF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation" title="{{localize 'SIMPLYPF2E.Preview.NotFound'}}"></i>{{/if}}
      </span>
    </div>

    <h3>{{localize "SIMPLYPF2E.Skills.Priorities"}}</h3>
    <p>{{#if pcPreview.automaticSkills}}{{localize "SIMPLYPF2E.Skills.Automatic"}}{{else}}{{localize "SIMPLYPF2E.Skills.PreferenceHint"}}{{/if}}</p>
    <ul class="spf-list spf-inline">
      {{#each pcPreview.skillPriorities}}<li>{{this.name}}</li>{{/each}}
    </ul>

    {{#if pcPreview.feats.length}}
      <h3>{{localize "SIMPLYPF2E.Preview.Feats"}}</h3>
      <ul class="spf-list spf-inline">
        {{#each pcPreview.feats}}
          <li class="{{#unless this.found}}spf-dropped{{/unless}}">
            {{this.name}}
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" title="{{localize 'SIMPLYPF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation" title="{{localize 'SIMPLYPF2E.Preview.NotFound'}}"></i>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if pcPreview.spellcastingNotice}}
      <p class="notification warning" role="status">{{pcPreview.spellcastingNotice}}</p>
    {{/if}}
    {{#if pcPreview.signatureSummary}}
      <p role="status">{{pcPreview.signatureSummary}}</p>
    {{/if}}
    {{#if pcPreview.concept.spellcasting}}
      <h3>{{localize "SIMPLYPF2E.Preview.Spells"}} <span class="spf-spell-dc">({{pcPreview.concept.spellcasting.tradition}})</span></h3>
      <ul class="spf-list spf-inline">
        {{#each pcPreview.spells}}
          <li class="{{#unless this.found}}spf-dropped{{/unless}}">
            {{this.name}} <span class="spf-rank">({{#if this.rank}}{{localize "SIMPLYPF2E.Preview.Rank"}} {{this.rank}}{{else}}{{localize "SIMPLYPF2E.Preview.Cantrip"}}{{/if}})</span>
            {{#if this.signature}}<span class="spf-rank">({{localize "SIMPLYPF2E.Preview.Signature"}})</span>{{/if}}
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" title="{{localize 'SIMPLYPF2E.Preview.Found'}}"></i>{{else}}<i class="fa-solid fa-circle-exclamation" title="{{localize 'SIMPLYPF2E.Preview.NotFound'}}"></i>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if pcPreview.equipment.length}}
      <h3>{{localize "SIMPLYPF2E.Preview.Equipment"}}</h3>
      <ul class="spf-list spf-inline">
        {{#each pcPreview.equipment}}
          <li>
            {{this.name}}
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" title="{{localize 'SIMPLYPF2E.Preview.Found'}}"></i>{{else}}<span class="spf-custom" title="{{localize 'SIMPLYPF2E.Preview.EquipmentCustom'}}">{{localize "SIMPLYPF2E.Preview.Custom"}}</span>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if pcPreview.loot.length}}
      <h3>{{localize "SIMPLYPF2E.Preview.Loot"}}</h3>
      <ul class="spf-list spf-inline">
        {{#each pcPreview.loot}}
          <li>
            {{this.name}}
            {{#if this.found}}<i class="fa-solid fa-circle-check spf-match" title="{{localize 'SIMPLYPF2E.Preview.Found'}}"></i>{{else}}<span class="spf-custom" title="{{localize 'SIMPLYPF2E.Preview.LootCustom'}}">{{localize "SIMPLYPF2E.Preview.Custom"}}</span>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if pcPreview.concept.backstory}}
      <h3>{{localize "SIMPLYPF2E.Preview.Backstory"}}</h3>
      <p class="spf-description">{{pcPreview.concept.backstory}}</p>
    {{/if}}

    {{#if tokenReport}}
      <div class="spf-token-report">
        <h3>{{localize "SIMPLYPF2E.Tokens.Heading"}}</h3>
        <ul>
          {{#each tokenReport.steps}}
            <li><strong>{{this.label}}</strong> — {{this.text}}</li>
          {{/each}}
        </ul>
        <p class="spf-token-total">{{tokenReport.totalText}}</p>
      </div>
    {{/if}}

    <footer class="spf-actions">
      <button type="button" class="spf-primary" data-action="createActor" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-user-plus"></i> {{localize "SIMPLYPF2E.Generator.CreateActor"}}
      </button>
      <button type="button" data-action="discard" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-trash"></i> {{localize "SIMPLYPF2E.Generator.Discard"}}
      </button>
    </footer>
  </section>
  {{/if}}
  {{#if characterReview}}
  <section class="spf-preview spf-card" aria-label="{{localize 'SIMPLYPF2E.Generator.ReviewTitle'}}">
    <h2>{{localize "SIMPLYPF2E.Generator.ReviewTitle"}}</h2>
    <h3>{{characterReview.actorName}}</h3>
    <p>{{localize "SIMPLYPF2E.Skills.Snapshot"}}</p>
    {{#if characterReview.skills}}
      <h3>{{localize "SIMPLYPF2E.Skills.Result"}}</h3>
      {{#if characterReview.skills.automatic}}<p>{{localize "SIMPLYPF2E.Skills.Automatic"}}</p>{{/if}}
      {{#if characterReview.skills.budget}}<p>{{characterReview.skills.budget}}</p>{{/if}}
      <ul class="spf-list spf-inline">
        {{#each characterReview.skills.rows}}<li>{{this.name}} — {{this.rank}}</li>{{/each}}
      </ul>
      {{#each characterReview.skills.warnings}}<p class="notification warning" role="status">{{this}}</p>{{/each}}
      {{#if characterReview.skills.loadoutWarnings}}
        <h3>{{localize "SIMPLYPF2E.Loadout.Result"}}</h3>
        {{#each characterReview.skills.loadoutWarnings}}<p class="notification warning" role="status">{{this}}</p>{{/each}}
      {{/if}}
    {{/if}}
    {{#if characterReview.choices.length}}
      <p class="notification warning" role="status">{{localize "SIMPLYPF2E.Generator.ReviewHint"}}</p>
    {{/if}}
    {{#if characterReview.incomplete}}
      <p class="notification warning" role="status">{{localize "SIMPLYPF2E.Generator.ReviewIncomplete"}}</p>
    {{/if}}
    <ul class="spf-list">
      {{#each characterReview.choices}}
        <li><strong>{{this.itemName}}</strong> — {{localize this.prompt}}</li>
      {{/each}}
    </ul>
    <footer class="spf-actions">
      <button type="button" data-action="openReviewedCharacter">{{localize "SIMPLYPF2E.Generator.OpenCharacter"}}</button>
      <button type="button" data-action="dismissCharacterReview">{{localize "SIMPLYPF2E.Generator.DismissReview"}}</button>
    </footer>
  </section>
  {{/if}}
</div>
