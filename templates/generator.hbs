<div class="spf-window-body simplysf2e-generator{{#if monsterMode}} spf-mode-monster{{else if npcMode}} spf-mode-npc{{else if encounterMode}} spf-mode-encounter{{else if characterMode}} spf-mode-character{{else if reskinMode}} spf-mode-reskin{{/if}}{{#if busy}} spf-busy{{/if}}">
  <div class="spf-statusbar">
  <div class="spf-provider-summary {{#if providerReady}}spf-provider-ready{{else}}spf-provider-attention{{/if}}" data-tooltip="{{providerBaseUrl}}">
    <span class="spf-provider-name">
      <i aria-hidden="true" class="fa-solid {{#if provider.local}}fa-server{{else}}fa-cloud{{/if}}"></i>
      {{#if canSwitchConnection}}
        <label for="spf-generator-connection" class="spf-sr-only">{{localize "SIMPLYSF2E.ProviderSetup.ActiveConnection"}}</label>
        <select id="spf-generator-connection" name="activeConnection" {{#if busy}}disabled{{/if}} aria-label="{{localize 'SIMPLYSF2E.ProviderSetup.ActiveConnection'}}">
          {{#each connections}}
            <option value="{{this.id}}" {{#if this.active}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      {{else}}
        <strong data-tooltip-text="{{#if connectionName}}{{connectionName}}{{else}}{{provider.name}}{{/if}}">{{#if connectionName}}{{connectionName}}{{else}}{{provider.name}}{{/if}}</strong>
      {{/if}}
    </span>
    <code class="spf-provider-model"{{#if provider.model}} data-tooltip-text="{{provider.model}}"{{/if}}>{{#if provider.model}}{{provider.model}}{{else}}{{localize "SIMPLYSF2E.Generator.NoModelShort"}}{{/if}}</code>
    {{#if lastRunCost}}<span class="spf-last-run" data-tooltip-text="{{lastRunCost}}">{{lastRunCost}}</span>{{/if}}
    <span class="spf-provider-actions">
      {{#if providerReady}}
        <button type="button" data-action="testProvider" data-tooltip="{{localize 'SIMPLYSF2E.ProviderSetup.TestConnection'}}" aria-label="{{localize 'SIMPLYSF2E.ProviderSetup.TestConnection'}}" {{#if busy}}disabled{{/if}}>
          <i aria-hidden="true" class="fa-solid fa-signal"></i>
        </button>
      {{/if}}
      <button type="button" data-action="configureProvider" data-tooltip="{{localize 'SIMPLYSF2E.ProviderSetup.Configure'}}" aria-label="{{localize 'SIMPLYSF2E.ProviderSetup.Configure'}}" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-gear"></i>
      </button>
      <i class="fa-solid {{#if providerReady}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}} spf-provider-state" role="img" aria-label="{{#if providerReady}}{{localize 'SIMPLYSF2E.Generator.ProviderReady'}}{{else}}{{apiKeyWarning}}{{/if}}" data-tooltip="{{#if providerReady}}{{localize 'SIMPLYSF2E.Generator.ProviderReady'}}{{else}}{{apiKeyWarning}}{{/if}}"></i>
    </span>
  </div>
  <div class="spf-provider-summary {{#if sourcesReady}}spf-provider-ready{{else}}spf-provider-attention{{/if}}">
    <span class="spf-provider-name"><i aria-hidden="true" class="fa-solid fa-book-atlas"></i> <strong>{{localize "SIMPLYSF2E.Generator.CompendiumContent"}}</strong></span>
    <span class="spf-provider-detail">{{#if sourcesReady}}{{localize "SIMPLYSF2E.Generator.SourcesReady" packCount=sourcePackCount}}{{else}}{{localize "SIMPLYSF2E.Generator.SourcesMissing" categories=sourceMissing}}{{/if}}</span>
    <span class="spf-provider-actions"><button type="button" data-action="configureSources" aria-label="{{localize 'SIMPLYSF2E.Generator.ConfigureSources'}}" {{#if busy}}disabled{{/if}}><i aria-hidden="true" class="fa-solid fa-gear"></i></button></span>
  </div>
  <div class="spf-provider-summary {{#if jevSource}}spf-provider-ready{{else}}spf-provider-off{{/if}}">
    <span class="spf-provider-name"><i aria-hidden="true" class="fa-solid fa-bolt"></i> <strong>{{localize "SIMPLYSF2E.Generator.JevRow"}}</strong></span>
    <span class="spf-provider-detail">{{#if (eq jevSource "key")}}{{localize "SIMPLYSF2E.Generator.JevOnKey"}}{{else if (eq jevSource "typesafe")}}{{localize "SIMPLYSF2E.Generator.JevOnTypeSafe"}}{{else if (eq jevSource "connection")}}{{localize "SIMPLYSF2E.Generator.JevOnConnection"}}{{else}}{{localize "SIMPLYSF2E.Generator.JevOff"}}{{/if}}</span>
    <span class="spf-provider-actions"><button type="button" data-action="configureProvider" data-tooltip="{{localize 'SIMPLYSF2E.Generator.JevConfigure'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.JevConfigure'}}" {{#if busy}}disabled{{/if}}><i aria-hidden="true" class="fa-solid fa-gear"></i></button></span>
  </div>
  </div>
  {{#if apiKeyWarning}}
    <p class="notification warning spf-provider-warning" role="status">
      <span>{{apiKeyWarning}}</span>
      {{#if canAuthorizeApiKey}}
        <span class="spf-provider-endpoint"><strong>{{localize "SIMPLYSF2E.Generator.ApiKeyEndpoint"}}</strong> <code>{{providerBaseUrl}}</code></span>
        <button type="button" data-action="authorizeApiKey" data-base-url="{{providerBaseUrl}}" {{#if busy}}disabled{{/if}}>{{localize "SIMPLYSF2E.Generator.AuthorizeApiKey"}}</button>
      {{/if}}
    </p>
  {{/if}}

  <fieldset class="spf-inputs spf-card" {{#if busy}}disabled{{/if}}>
    <legend>
      {{#if encounterMode}}
        {{localize "SIMPLYSF2E.Generator.EncounterLegend"}}
      {{else if characterMode}}
        {{localize "SIMPLYSF2E.Generator.CharacterLegend"}}
      {{else if npcMode}}
        {{localize "SIMPLYSF2E.Generator.NpcLegend"}}
      {{else if reskinMode}}
        {{localize "SIMPLYSF2E.Generator.ReskinLegend"}}
      {{else}}
        {{localize "SIMPLYSF2E.Generator.ConceptLegend"}}
      {{/if}}
    </legend>
    <div class="spf-mode-toggle" role="radiogroup" aria-label="{{localize 'SIMPLYSF2E.Generator.ModeLabel'}}">
      <label class="spf-mode-monster{{#if monsterMode}} spf-mode-active{{/if}}" data-tooltip="{{localize 'SIMPLYSF2E.Mode.MonsterHint'}}">
        <input type="radio" name="mode" value="monster" {{#if monsterMode}}checked{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-dna"></i> {{localize "SIMPLYSF2E.Mode.Monster"}}
      </label>
      <label class="spf-mode-npc{{#if npcMode}} spf-mode-active{{/if}}" data-tooltip="{{localize 'SIMPLYSF2E.Mode.NpcHint'}}">
        <input type="radio" name="mode" value="npc" {{#if npcMode}}checked{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-id-badge"></i> {{localize "SIMPLYSF2E.Mode.Npc"}}
      </label>
      <label class="spf-mode-encounter{{#if encounterMode}} spf-mode-active{{/if}}" data-tooltip="{{localize 'SIMPLYSF2E.Mode.EncounterHint'}}">
        <input type="radio" name="mode" value="encounter" {{#if encounterMode}}checked{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-crosshairs"></i> {{localize "SIMPLYSF2E.Mode.Encounter"}}
      </label>
      <label class="spf-mode-character{{#if characterMode}} spf-mode-active{{/if}}" data-tooltip="{{localize 'SIMPLYSF2E.Mode.CharacterHint'}}">
        <input type="radio" name="mode" value="character" {{#if characterMode}}checked{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-user-astronaut"></i> {{localize "SIMPLYSF2E.Mode.Character"}}
      </label>
      <label class="spf-mode-reskin{{#if reskinMode}} spf-mode-active{{/if}}" data-tooltip="{{localize 'SIMPLYSF2E.Mode.ReskinHint'}}">
        <input type="radio" name="mode" value="reskin" {{#if reskinMode}}checked{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-masks-theater"></i> {{localize "SIMPLYSF2E.Mode.Reskin"}}
      </label>
    </div>
    {{#if reskinMode}}
    <div class="spf-reskin-drop{{#if reskinSource}} spf-reskin-has-source{{/if}}" data-reskin-drop aria-describedby="spf-reskin-drop-hint">
      {{#if reskinSource}}
        {{#if reskinSource.img}}<img src="{{reskinSource.img}}" alt="">{{else}}<i class="fa-solid fa-masks-theater" aria-hidden="true"></i>{{/if}}
        <span class="spf-reskin-source">
          <strong data-tooltip-text="{{reskinSource.name}}">{{reskinSource.name}}</strong>
          <span>{{localize "SIMPLYSF2E.Generator.ReskinSourceLevel" level=reskinSource.level}}</span>
          <span id="spf-reskin-drop-hint" class="spf-hint">{{localize "SIMPLYSF2E.Generator.ReskinDropReplace"}}</span>
        </span>
      {{else}}
        <i class="fa-solid fa-masks-theater" aria-hidden="true"></i>
        <span id="spf-reskin-drop-hint">{{localize "SIMPLYSF2E.Generator.ReskinDropHint"}}</span>
      {{/if}}
    </div>
    {{/if}}
    <div class="form-group stacked">
      {{#if encounterMode}}
        <label for="spf-generator-prompt">{{localize "SIMPLYSF2E.Generator.EncounterTheme"}}</label>
        <textarea id="spf-generator-prompt" name="prompt" rows="3" placeholder="{{localize 'SIMPLYSF2E.Generator.EncounterThemePlaceholder'}}">{{input.prompt}}</textarea>
      {{else if characterMode}}
        <label for="spf-generator-prompt">{{localize "SIMPLYSF2E.Generator.CharacterPrompt"}}</label>
        <textarea id="spf-generator-prompt" name="prompt" rows="3" placeholder="{{localize 'SIMPLYSF2E.Generator.CharacterPromptPlaceholder'}}">{{input.prompt}}</textarea>
      {{else if reskinMode}}
        <label for="spf-generator-prompt">{{localize "SIMPLYSF2E.Generator.ReskinPrompt"}}</label>
        <textarea id="spf-generator-prompt" name="prompt" rows="3" placeholder="{{localize 'SIMPLYSF2E.Generator.ReskinPromptPlaceholder'}}">{{input.prompt}}</textarea>
      {{else if npcMode}}
        <label for="spf-generator-prompt">{{localize "SIMPLYSF2E.Generator.NpcPrompt"}}</label>
        <textarea id="spf-generator-prompt" name="prompt" rows="3" placeholder="{{localize 'SIMPLYSF2E.Generator.NpcPromptPlaceholder'}}">{{input.prompt}}</textarea>
      {{else}}
        <label for="spf-generator-prompt">{{localize "SIMPLYSF2E.Generator.Prompt"}}</label>
        <textarea id="spf-generator-prompt" name="prompt" rows="3" placeholder="{{promptPlaceholder}}">{{input.prompt}}</textarea>
      {{/if}}
    </div>
    {{#unless reskinMode}}
    <div class="spf-level-primary">
      <div class="form-group">
        <label for="spf-generator-level">{{#if encounterMode}}{{localize "SIMPLYSF2E.Generator.PartyLevel"}}{{else}}{{localize "SIMPLYSF2E.Generator.Level"}}{{/if}}</label>
        <div class="spf-level-controls">
          <button type="button" class="spf-icon-btn" data-action="levelDown" data-tooltip="{{localize 'SIMPLYSF2E.Generator.LevelDown'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.LevelDown'}}">
            <i aria-hidden="true" class="fa-solid fa-minus"></i>
          </button>
          <input id="spf-generator-level" type="number" name="level" min="{{levelMin}}" max="{{levelMax}}" step="1" value="{{input.level}}">
          <button type="button" class="spf-icon-btn" data-action="levelUp" data-tooltip="{{localize 'SIMPLYSF2E.Generator.LevelUp'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.LevelUp'}}">
            <i aria-hidden="true" class="fa-solid fa-plus"></i>
          </button>
        </div>
      </div>
    </div>
    <details class="spf-advanced">
      <summary>{{localize "SIMPLYSF2E.Generator.Advanced"}}</summary>
      <div class="spf-advanced-content">
        {{! One stable slot in every mode: presets guide every pipeline. Creation,
            duplication, export, and deletion live in the dedicated manager. }}
        <div class="form-group spf-preset stacked">
          <label for="spf-generator-preset">{{localize "SIMPLYSF2E.Generator.Preset"}}</label>
          <div class="spf-preset-controls">
            <select id="spf-generator-preset" name="preset" aria-describedby="spf-generator-preset-trust">
              <option value="" {{#if nonePresetSelected}}selected{{/if}}>{{localize "SIMPLYSF2E.Presets.None"}}</option>
              <optgroup label="{{localize 'SIMPLYSF2E.Presets.StandardGroup'}}">
                {{#each standardPresets}}
                  <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
              </optgroup>
              {{#if archetypePresets.length}}
              <optgroup label="{{localize 'SIMPLYSF2E.Presets.ArchetypesGroup'}}">
                {{#each archetypePresets}}
                  <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
              </optgroup>
              {{/if}}
              {{#if customPresets.length}}
              <optgroup label="{{localize 'SIMPLYSF2E.Presets.CustomGroup'}}">
                {{#each customPresets}}
                  <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
              </optgroup>
              {{/if}}
            </select>
            <button type="button" data-action="managePresets">
              <i class="fa-solid fa-bookmark" aria-hidden="true"></i> {{localize "SIMPLYSF2E.Presets.Manage"}}
            </button>
          </div>
          <p id="spf-generator-preset-trust" class="spf-hint spf-preset-trust" role="note">{{localize "SIMPLYSF2E.Presets.FlavorGuide"}}</p>
        </div>
        <div class="spf-row">
      {{! Stable shared column order in every mode: Level → Rarity (a cap in
          Character mode) → Treasure amount → Allow spellcasting. The level
          remains prominent above; encounter-specific controls append here. }}
      {{#if characterMode}}
        <div class="form-group">
          <label for="spf-generator-rarity-cap" data-tooltip="{{localize 'SIMPLYSF2E.Generator.RarityCapTooltip'}}">{{localize "SIMPLYSF2E.Generator.RarityCap"}}</label>
          <select id="spf-generator-rarity-cap" name="rarityCap">
            {{#each rarities}}
              <option value="{{this.value}}" {{#if (eq this.value @root.input.rarityCap)}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
          </select>
        </div>
      {{else}}
        <div class="form-group">
          <label for="spf-generator-rarity">{{localize "SIMPLYSF2E.Generator.Rarity"}}</label>
          <select id="spf-generator-rarity" name="rarity">
            {{#each rarities}}
              <option value="{{this.value}}" {{#if (eq this.value @root.input.rarity)}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
          </select>
        </div>
      {{/if}}
      {{! Elite/Weak applies to a single Monster/NPC only; encounter members ignore it. }}
      {{#unless characterMode}}{{#unless encounterMode}}
      <div class="form-group">
        <label for="spf-generator-adjustment">{{localize "SIMPLYSF2E.Generator.Adjustment"}}</label>
        <select id="spf-generator-adjustment" name="adjustment">
          <option value="" {{#unless input.adjustment}}selected{{/unless}}>{{localize "SIMPLYSF2E.Generator.AdjustmentNormal"}}</option>
          <option value="elite" {{#if (eq input.adjustment "elite")}}selected{{/if}}>{{localize "SIMPLYSF2E.Generator.AdjustmentElite"}}</option>
          <option value="weak" {{#if (eq input.adjustment "weak")}}selected{{/if}}>{{localize "SIMPLYSF2E.Generator.AdjustmentWeak"}}</option>
        </select>
      </div>
      {{/unless}}{{/unless}}
      <div class="form-group">
        <label for="spf-generator-treasure-amount">{{localize "SIMPLYSF2E.Generator.TreasureAmount"}}</label>
        <select id="spf-generator-treasure-amount" name="treasureAmount">
          {{#each treasureAmounts}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group spf-checkbox">
        <label>
          <input type="checkbox" name="allowSpellcasting" {{#if input.allowSpellcasting}}checked{{/if}}>
          {{localize "SIMPLYSF2E.Generator.AllowSpellcasting"}}
        </label>
      </div>
      {{#if encounterMode}}
        <div class="form-group">
          <label for="spf-generator-party-size">{{localize "SIMPLYSF2E.Generator.PartySize"}}</label>
          <div class="spf-level-controls">
            <button type="button" class="spf-icon-btn" data-action="partyDown" data-tooltip="{{localize 'SIMPLYSF2E.Generator.PartySizeDown'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.PartySizeDown'}}">
              <i aria-hidden="true" class="fa-solid fa-minus"></i>
            </button>
            <input id="spf-generator-party-size" type="number" name="partySize" min="1" max="8" step="1" value="{{input.partySize}}">
            <button type="button" class="spf-icon-btn" data-action="partyUp" data-tooltip="{{localize 'SIMPLYSF2E.Generator.PartySizeUp'}}" aria-label="{{localize 'SIMPLYSF2E.Generator.PartySizeUp'}}">
              <i aria-hidden="true" class="fa-solid fa-plus"></i>
            </button>
          </div>
        </div>
        <div class="form-group">
          <label for="spf-generator-threat">{{localize "SIMPLYSF2E.Generator.Threat"}}</label>
          <select id="spf-generator-threat" name="threat">
            {{#each threats}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
          </select>
        </div>
      {{/if}}
        </div>
      </div>
    </details>
    {{/unless}}
    <div class="spf-generate-row">
      <button type="button" class="spf-primary" data-action="generate" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-wand-sparkles"></i>
        {{#if monsterMode}}{{localize "SIMPLYSF2E.Generator.GenerateMonster"}}{{else if npcMode}}{{localize "SIMPLYSF2E.Generator.GenerateNpc"}}{{else if encounterMode}}{{localize "SIMPLYSF2E.Generator.GenerateEncounter"}}{{else if reskinMode}}{{localize "SIMPLYSF2E.Generator.GenerateReskin"}}{{else}}{{localize "SIMPLYSF2E.Generator.GenerateCharacter"}}{{/if}}
      </button>
      <button type="button" class="spf-secondary" data-action="previewPlan" {{#if busy}}disabled{{/if}}>{{localize "SIMPLYSF2E.Generator.PreviewPlan"}}</button>
      {{#unless reskinMode}}
      <button type="button" class="spf-random-button" data-action="generateRandom" data-tooltip="{{localize randomTooltipKey}}" aria-label="{{localize randomTooltipKey}}" {{#if busy}}disabled{{/if}}>
        <i aria-hidden="true" class="fa-solid fa-dice-d20"></i>
      </button>
      {{/unless}}
    </div>
  </fieldset>

  {{#if busy}}{{> simplysf2e-progress}}{{/if}}

  {{#if error}}
    <div class="spf-error-notice notification error">
      <p role="alert">{{error}}</p>
      {{#if canReportBug}}
      <button type="button" class="spf-secondary spf-bug-report" data-action="copyBugReport" data-tooltip="{{localize 'SIMPLYSF2E.BugReport.Tooltip'}}">
        <i aria-hidden="true" class="fa-solid fa-bug"></i> {{localize "SIMPLYSF2E.BugReport.Copy"}}
      </button>
      {{/if}}
    </div>
  {{/if}}

  {{#if created}}
  <section class="spf-preview spf-card" aria-label="{{localize 'SIMPLYSF2E.Generator.CompleteTitle'}}">
    <header class="spf-statblock-header">
      <h2>{{localize "SIMPLYSF2E.Generator.CompleteTitle"}}</h2>
    </header>
    <p>{{#if created.inFolder}}{{#if (eq created.count 1)}}{{localize "SIMPLYSF2E.Generator.CreatedOneInFolder" name=created.name}}{{else}}{{localize "SIMPLYSF2E.Generator.CreatedAll" name=created.name count=created.count}}{{/if}}{{else if (eq created.count 1)}}{{localize "SIMPLYSF2E.Generator.Created" name=created.name}}{{else}}{{localize "SIMPLYSF2E.Generator.CompleteSummary" name=created.name count=created.count}}{{/if}}</p>
    {{#if created.grounding.total}}
      <h3>{{localize "SIMPLYSF2E.Generator.CompletionGrounding"}}</h3>
      <ul class="spf-list">
        {{#each created.grounding.rows}}<li>{{this.text}}</li>{{/each}}
      </ul>
    {{/if}}
    {{#if tokenReport}}
      <div class="spf-token-report">
        <h3>{{localize "SIMPLYSF2E.Tokens.Heading"}}</h3>
        <ul>
          {{#each tokenReport.steps}}<li><strong>{{this.label}}</strong> — {{this.text}}</li>{{/each}}
        </ul>
        <p class="spf-token-total">{{tokenReport.totalText}}</p>
      </div>
    {{/if}}
    <footer class="spf-actions">
      {{#if created.actorId}}<button type="button" class="spf-primary" data-action="openCreatedActor"><i aria-hidden="true" class="fa-solid fa-arrow-up-right-from-square"></i> {{localize "SIMPLYSF2E.Generator.OpenSheet"}}</button>{{/if}}
      <button type="button" data-action="generateAnother"><i aria-hidden="true" class="fa-solid fa-wand-sparkles"></i> {{localize "SIMPLYSF2E.Generator.GenerateAnother"}}</button>
    </footer>
  </section>
  {{/if}}

  {{#if showEmptyState}}
    <p class="spf-empty">{{#if reskinMode}}{{localize "SIMPLYSF2E.Generator.EmptyHintReskin"}}{{else}}{{localize "SIMPLYSF2E.Generator.EmptyHint"}}{{/if}}</p>
  {{/if}}

  {{#if preview}}
  <section class="spf-preview spf-card">
    <header class="spf-statblock-header">
      <h2>{{preview.concept.name}}</h2>
      <span class="spf-level">{{localize "SIMPLYSF2E.Generator.Creature"}} {{preview.stats.level}}</span>
      {{#if preview.matchSummary}}<span class="spf-level spf-match-summary" data-tooltip="{{localize 'SIMPLYSF2E.Preview.Found'}}"><i aria-hidden="true" class="fa-solid fa-circle-check"></i> {{preview.matchSummary.text}}</span>{{/if}}
    </header>
    {{#if preview.concept.blurb}}<p class="spf-blurb"><em>{{preview.concept.blurb}}</em></p>{{/if}}
    <div class="spf-traits">
      {{#each preview.traits}}<span class="spf-trait">{{this}}</span>{{/each}}
    </div>

    <div class="spf-statline">
      <span><strong>{{localize "SIMPLYSF2E.Preview.Perception"}}</strong> {{preview.display.perception}}{{#if preview.senses}}; {{preview.senses}}{{/if}}</span>
      {{#if preview.languages}}<span><strong>{{localize "SIMPLYSF2E.Preview.Languages"}}</strong> {{preview.languages}}</span>{{/if}}
      {{#if preview.stats.skills.length}}
        <span><strong>{{localize "SIMPLYSF2E.Preview.Skills"}}</strong>
          {{#each preview.display.skills}}{{this.name}} {{this.mod}}{{#unless @last}}, {{/unless}}{{/each}}
        </span>
      {{/if}}
    </div>

    <div class="spf-statgrid">
    <div class="spf-statline spf-defenses">
      <span><strong>{{localize "SIMPLYSF2E.Preview.AC"}}</strong> {{preview.stats.ac}}</span>
      <span><strong>{{localize "SIMPLYSF2E.Preview.Fort"}}</strong> {{preview.display.saves.fortitude}}</span>
      <span><strong>{{localize "SIMPLYSF2E.Preview.Ref"}}</strong> {{preview.display.saves.reflex}}</span>
      <span><strong>{{localize "SIMPLYSF2E.Preview.Will"}}</strong> {{preview.display.saves.will}}</span>
      <span><strong>{{localize "SIMPLYSF2E.Preview.HP"}}</strong> {{preview.stats.hp}}</span>
    </div>
    {{#if preview.iwr.immunities}}<div class="spf-statline"><span><strong>{{localize "SIMPLYSF2E.Preview.Immunities"}}</strong> {{preview.iwr.immunities}}</span></div>{{/if}}
    {{#if preview.iwr.resistances}}<div class="spf-statline"><span><strong>{{localize "SIMPLYSF2E.Preview.Resistances"}}</strong> {{preview.iwr.resistances}}</span></div>{{/if}}
    {{#if preview.iwr.weaknesses}}<div class="spf-statline"><span><strong>{{localize "SIMPLYSF2E.Preview.Weaknesses"}}</strong> {{preview.iwr.weaknesses}}</span></div>{{/if}}
    </div>

    <div class="spf-statline">
      <span><strong>{{localize "SIMPLYSF2E.Preview.Speed"}}</strong> {{preview.speeds}}</span>
    </div>

    <div class="spf-strikes">
      {{#each preview.display.strikes}}
        <div class="spf-strike">
          <strong>{{#if (eq this.type "ranged")}}{{localize "SIMPLYSF2E.Preview.Ranged"}}{{else}}{{localize "SIMPLYSF2E.Preview.Melee"}}{{/if}}</strong>
          {{this.name}} {{this.bonusText}},
          <strong>{{localize "SIMPLYSF2E.Preview.Damage"}}</strong> {{this.damage}} {{this.damageType}}
